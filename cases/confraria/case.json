  "manifesto": {
    "nav": "Manifesto",
    "eyebrow": "03 — Manifesto",
    "headline": "[rascunho] Uma confraria é gente reunida em torno do que ama. Aqui, quem reúne é o aroma: feito à mão, para encher a casa de memória.",
    "attributes": [
      { "word": "Artesanal", "text": "[rascunho] Feito à mão, em casa, com o cuidado de quem prepara um presente." },
      { "word": "Natureza", "text": "[rascunho] As vinhas do logotipo trazem o verde e o frescor do jardim para dentro de casa." },
      { "word": "Acolhimento", "text": "[rascunho] Aromas que transformam a casa em lugar de ficar." },
      { "word": "Encontro", "text": "[rascunho] Confraria é reunião: a marca convida a sentir junto." }
    ]
  },

