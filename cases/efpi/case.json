  "manifesto": {
    "nav": "Manifesto",
    "eyebrow": "03 — Manifesto",
    "headline": "Todo conhecimento começa pequeno. Ele sobe, ganha clareza e, quando atravessa alguém, muda o mundo ao redor.",
    "attributes": [
      {
        "word": "Elevação",
        "text": "Aprender é um movimento para cima — sempre um degrau além."
      },
      {
        "word": "Transparência",
        "text": "Como num prisma, o saber atravessa e se revela por inteiro."
      },
      {
        "word": "Diálogo",
        "text": "Ideias que se formam na conversa aberta, com espaço para cada opinião."
      },
      {
        "word": "Transformação",
        "text": "Conhecimento que muda o mundo, começando por quem aprende."
      }
    ]
  },
