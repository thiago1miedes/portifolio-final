  "manifesto": {
    "nav": "Manifesto",
    "eyebrow": "03 — Manifesto",
    "headline": "Uma peça costurada à mão guarda o tempo de quem a fez. A Faggian veste esse tempo: ponto a ponto, para durar mais que uma estação.",
    "attributes": [
      {
        "word": "Artesanal",
        "text": "Cada peça passa pelas mãos de quem costura, com o cuidado de quem conhece o tecido pelo toque."
      },
      {
        "word": "Refinada",
        "text": "Alto padrão sem ostentação: o refinamento está no corte, no caimento e no acabamento."
      },
      {
        "word": "Autoral",
        "text": "Uma marca independente que leva o nome de quem a criou: Faggian nasce da mistura do nome e do sobrenome de Giovanna."
      },
      {
        "word": "Atemporal",
        "text": "Camisas e bolsas pensadas para atravessar estações, não para seguir a próxima tendência."
      }
    ]
  },
  "colors": {
    "nav": "Cores",
    "eyebrow": "04 — Cores",
    "title": "Terracota, linho e um fio de latão.",
    "text": "A terracota e o grafite vêm do próprio logo. Em volta deles, tons de fibra natural e de ateliê: o café de um fundo profundo, o linho e o algodão cru dos tecidos e o latão de botões, agulhas e fechos, usado pouco, como um detalhe de acabamento.",
    "note": "Terracota e grafite tirados do SVG do logo. CMYK aproximado em todas as cores: confirme no perfil da gráfica.",
