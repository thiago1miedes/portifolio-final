  "manifesto": {
    "nav": "Manifesto",
    "eyebrow": "03 — Manifesto",
    "headline": "Uma peça costurada à mão guarda o tempo de quem a fez. A Faggian veste esse tempo: ponto a ponto, para durar mais que uma estação.",
    "attributes": [
      { "word": "Artesanal", "text": "Cada peça passa pelas mãos de quem costura, com o cuidado de quem conhece o tecido pelo toque." },
      { "word": "Refinada", "text": "Alto padrão sem ostentação: o refinamento está no corte, no caimento e no acabamento." },
      { "word": "Autoral", "text": "Uma marca independente, com o olhar e a assinatura de quem cria cada modelo." },
      { "word": "Atemporal", "text": "Camisas e bolsas pensadas para atravessar estações, não para seguir a próxima tendência." }
    ]
  },

