  "manifesto": {
    "nav": "Manifesto",
    "eyebrow": "",
    "headline": "Fermentada sem pressa, pelas mãos de quem faz, e vendida aqui mesmo na cidade.",
    "attributes": [
      {
        "word": "Viva",
        "text": "Uma bebida que fermenta e continua mudando até chegar ao copo."
      },
      {
        "word": "Artesanal",
        "text": "Feita pelo próprio produtor, do chá à garrafa."
      },
      {
        "word": "Paciente",
        "text": "O tempo da fermentação manda mais do que o relógio."
      },
      {
        "word": "Próxima",
        "text": "Vendida de mão em mão, na rua de quem bebe."
      }
    ]
  },
