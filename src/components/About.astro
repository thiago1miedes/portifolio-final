---
import { site } from "../data/site";

// Cena em pixel art: mesa de trabalho com monitor, planta e caneca.
const S = [
  "ssssssssssssssss",
  "sggsssssstsststs",
  "ssssssssssssssss",
  "sffffffffsstttts",
  "sffffffsssstttts",
  "ssssssssssstttts",
  "slllssssssstttts",
  "ssssssssssssssss",
  "sgggsgggsgggsggs",
  "ssssssssssssssss",
];
const M = "m".repeat(18);
const rows = [
  "................................",
  "................................",
  "........" + M + "......",
  "........" + "m" + S[0] + "m" + "......",
  "........" + "m" + S[1] + "m" + "......",
  "..g....." + "m" + S[2] + "m" + "......",
  ".gfg...." + "m" + S[3] + "m" + "......",
  "gfgfg..." + "m" + S[4] + "m" + "......",
  ".gfgfg.." + "m" + S[5] + "m" + "......",
  "gfgfg..." + "m" + S[6] + "m" + "......",
  ".gfgf..." + "m" + S[7] + "m" + "......",
  "..ff...." + "m" + S[8] + "m" + "..w...",
  "..f....." + "m" + S[9] + "m" + "...w..",
  ".pppp..." + M + "..w...",
  ".pppp..." + "........mm........" + ".ccc..",
  ".pppp..." + "......mmmmmm......" + ".cccw.",
  "k".repeat(32),
  "k".repeat(32),
  ".k......" + ".".repeat(18) + "....k.",
  ".k......" + ".".repeat(18) + "....k.",
];
const pal: Record<string, string> = {
  m: "#0b2a2f", s: "#f3fbf7", g: "#3cc46b", f: "#1e8a4c", t: "#148a85", l: "#b8f05e",
  w: "#b9cfc9", p: "#0f4c5c", c: "#4ee0c2", k: "#0b3a47",
};
const values = [
  { t: "Detalhe que se vê", d: "Cada espaçamento, cor e microinteração pensados para o site parecer tão bom quanto a marca é." },
  { t: "Código leve", d: "Sites rápidos, responsivos e fáceis de manter — sem plugin desnecessário." },
  { t: "Conversa direta", d: "Você fala comigo, sem intermediários. Prazos claros e atualizações a cada etapa." },
];
---
<section class="section about" id="sobre">
  <div class="container about-grid">
    <div class="about-visual" data-reveal="up">
      <div class="photo">
        <img src="/about/thiago.webp" width="898" height="1123" alt="Thiago Miedes, web designer e desenvolvedor front-end" loading="lazy" decoding="async" />
        <span class="photo-tag"><i></i>Thiago Miedes</span>
      <div class="scene">
        <svg viewBox="0 0 32 20" shape-rendering="crispEdges" aria-label="Ilustração em pixel art de uma mesa de trabalho com computador, planta e café" role="img">
          {rows.map((row, y) => [...row].map((ch, x) => pal[ch] && (
            <rect x={x} y={y} width="1" height="1" fill={pal[ch]} class={ch === "l" ? "blink" : ch === "w" ? "steam" : undefined} />
          )))}
        </svg>
      </div>
      </div>
      <div class="about-badges">
        <span class="chip chip--pixel"><i class="dot"></i>{site.city}</span>
        <span class="chip chip--pixel">Atendo todo o Brasil</span>
        <span class="chip chip--pixel">Freelancer</span>
      </div>
    </div>

    <div class="about-copy">
      <span class="eyebrow" data-reveal>Sobre mim</span>
      <h2 class="h-section" data-split>Um designer que fala a língua do <span class="hl">código</span>.</h2>
      <div class="about-text" data-reveal>
        <p class="lead">Sou Thiago Miedes, designer gráfico e web designer em Bauru (SP). Comecei pela identidade visual e pelo social media e, projeto após projeto, levei o cuidado com o detalhe para a web — primeiro no layout, depois no código.</p>
        <p>Na agência Olive Comunicação desenhei sites como Deliziare, Palmont e Massas Ivaí. Hoje atendo marcas e agências de todo o Brasil — como a Apex Comunicação — do protótipo no Figma ao site publicado, com animações, responsividade e SEO.</p>
      </div>
      <ul class="values">
        {values.map((v, i) => (
          <li data-reveal="up">
            <span class="v-num">0{i + 1}</span>
            <div><h3>{v.t}</h3><p>{v.d}</p></div>
          </li>
        ))}
      </ul>
      <div class="about-links" data-reveal>
        {site.social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" class="link-arrow">{s.label} <span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid { display: grid; gap: clamp(40px, 6vw, 96px); align-items: center; }
  @media (min-width: 1000px) { .about-grid { grid-template-columns: 0.9fr 1.1fr; } }
  .about-visual { display: grid; gap: 16px; }
  .photo { position: relative; border-radius: 28px; box-shadow: 0 0 0 1px var(--line), var(--shadow-lg); }
  .photo > img { width: 100%; height: auto; border-radius: 28px; aspect-ratio: 4 / 5; object-fit: cover; }
  .photo-tag { position: absolute; left: 16px; top: 16px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; background: #fff; border-radius: 6px; font-family: var(--font-pixel); font-size: 13px; letter-spacing: 0.04em; color: var(--marine); box-shadow: var(--shadow); }
  .photo-tag i { width: 8px; height: 8px; background: var(--leaf); }
  .photo .scene { position: absolute; right: -14px; bottom: -22px; width: 46%; padding: 12px; border-radius: 16px; background: #fff; box-shadow: 0 0 0 1px var(--line), var(--shadow); }
  @media (min-width: 1000px) { .photo .scene { right: -28px; } }
  .scene {
    position: relative;
    padding: clamp(28px, 5vw, 56px);
    border-radius: 28px;
    background:
      linear-gradient(to right, rgba(15, 76, 92, 0.06) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(to bottom, rgba(15, 76, 92, 0.06) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(170deg, var(--mint-2), #fff 70%);
    box-shadow: 0 0 0 1px var(--line);
  }
  .scene svg { width: 100%; height: auto; }
  .scene :global(.blink) { animation: blink-px 1.1s steps(1) infinite; }
  .scene :global(.steam) { animation: steam 2.4s steps(3) infinite; }
  @keyframes blink-px { 50% { opacity: 0; } }
  @keyframes steam { 0% { opacity: 0.9; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-2px); } }
  .about-badges { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 8px; }
  .about-badges .dot { width: 6px; height: 6px; background: var(--leaf); }
  .about-copy { display: grid; gap: 26px; }
  .about-text { display: grid; gap: 16px; color: var(--ink-2); }
  .values { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .values li { display: grid; grid-template-columns: 48px 1fr; gap: 12px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .v-num { font-family: var(--font-pixel); color: var(--forest); font-size: 14px; padding-top: 4px; }
  .values h3 { font-size: 1.2rem; letter-spacing: -0.02em; margin-bottom: 4px; }
  .values p { font-size: 15.5px; color: var(--ink-2); }
  .about-links { display: flex; flex-wrap: wrap; gap: 14px 28px; }
</style>
