---
import Sticker from "./Sticker.astro";
import { about, timeline, site } from "../data/site";
const visible = 3;
---
<section class="section about" id="sobre">
  <div class="container about-grid">
    <div class="about-photo" data-reveal>
      <div class="about-tilt">
      <figure class="about-portrait">
        <img src="/about/thiago.webp" width="900" height="1126" alt="Retrato de Thiago Miedes de braços cruzados diante de um mural grafitado" loading="lazy" decoding="async" data-portrait />
        <figcaption class="about-caption">
          <span>{site.name}</span>
          <span>{site.city}</span>
        </figcaption>
      </figure>
      <span class="about-tape" aria-hidden="true"></span>
      <Sticker name="spark" x="86%" y="-3%" size="17%" r={14} msize="62px" mx="84%" my="-3%" />
      <Sticker name="smile" x="-5%" y="17%" size="15%" r={-12} msize="56px" mx="-3%" my="16%" />
      <Sticker name="bolt" x="90%" y="62%" size="13%" r={10} msize="48px" mx="88%" my="60%" />
      </div>
    </div>

    <div class="about-content">
      <h2 class="title-section" data-split>Design que faz <em>sentido</em>.</h2>
      <div class="about-text" data-reveal>
        {about.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
      </div>

      <div class="timeline" data-reveal>
        <h3 class="timeline-title">Minha trajetória</h3>
        <ol class="timeline-list" id="timeline-list">
          {timeline.map((t, i) => (
            <li class:list={["timeline-item", { "is-hidden": i >= visible }]} data-timeline-extra={i >= visible ? "" : undefined}>
              <span class="timeline-company">{t.company}</span>
              <span class="timeline-role">{t.role}</span>
              {t.period && <span class="timeline-period">{t.period}</span>}
            </li>
          ))}
        </ol>
        {timeline.length > visible && (
          <button type="button" class="btn btn--ghost btn--sm timeline-more" aria-expanded="false" aria-controls="timeline-list" data-open="timeline">
            <span data-open-label>Ver tudo</span>
          </button>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .about { overflow-x: clip; }
  .about-grid { display: grid; gap: clamp(40px, 6vw, 96px); align-items: start; }
  @media (min-width: 1000px) {
    .about-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
    .about-photo { position: sticky; top: 110px; }
  }

  /* retrato (foto real) inclinado e colado com fita; endireita com o mouse em cima */
  .about-photo { margin-inline: 2%; }
  .about-tilt { position: relative; rotate: -2.5deg; transition: rotate 0.6s var(--ease); }
  @media (hover: hover) and (pointer: fine) { .about-tilt:hover { rotate: -0.5deg; } }
  .about-tape {
    position: absolute;
    left: 50%;
    top: -15px;
    width: 130px;
    height: 32px;
    translate: -50% 0;
    rotate: 2deg;
    background: rgba(255, 90, 31, 0.88);
    clip-path: polygon(0 0, 3% 12%, 0 25%, 3% 37%, 0 50%, 3% 62%, 0 75%, 3% 87%, 0 100%, 100% 100%, 97% 87%, 100% 75%, 97% 62%, 100% 50%, 97% 37%, 100% 25%, 97% 12%, 100% 0);
    pointer-events: none;
  }
  .about-portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.8);
  }
  .about-portrait img { position: absolute; left: 0; top: -4%; width: 100%; height: 108%; object-fit: cover; }
  .about-caption {
    position: absolute;
    left: 16px; right: 16px; bottom: 16px;
    display: flex; justify-content: space-between; gap: 12px;
    padding: 12px 18px;
    border-radius: var(--radius-pill);
    background: rgba(10, 10, 11, 0.62);
    border: 1px solid var(--border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--fs-small);
    color: var(--text);
  }

  .about-content { display: grid; gap: 28px; }
  .about-text { display: grid; gap: 16px; color: var(--text-muted); max-width: 62ch; }
  .about-text .lead { font-size: var(--fs-body); color: var(--text); }

  .timeline {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--radius-card);
    background: var(--surface-glass);
    border: 1px solid var(--border);
  }
  .timeline-title { font-size: var(--fs-card); letter-spacing: -0.03em; }
  .timeline-list { display: grid; width: 100%; }
  .timeline-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 16px;
    padding-block: 14px;
    border-top: 1px solid var(--border);
  }
  .timeline-company { font-family: var(--font-heading); font-weight: 600; font-size: var(--fs-body); letter-spacing: -0.01em; }
  .timeline-role { grid-row: 2; font-size: var(--fs-small); color: var(--text-muted); }
  .timeline-period { grid-row: 1 / span 2; grid-column: 2; align-self: center; font-size: var(--fs-small); color: var(--accent); font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
