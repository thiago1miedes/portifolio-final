---
import { behance } from "../data/behance";
import { site } from "../data/site";
---
<section class="section behance">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <span class="eyebrow" data-reveal>Também no Behance</span>
        <h2 class="h-section" data-split style="margin-top:18px">Mais projetos, <span class="hl">mais histórias</span>.</h2>
      </div>
      <div class="be-stats" data-reveal>
        <div><b>{site.behanceStats.views}</b><span>visualizações</span></div>
        <div><b>{site.behanceStats.appreciations}</b><span>avaliações</span></div>
        <div><b>{site.behanceStats.followers}</b><span>seguidores</span></div>
      </div>
    </div>
  </div>
  <div class="be-rail" data-rail>
    <ul class="be-track">
      {behance.map((b) => (
        <li>
          <a href={b.href} target="_blank" rel="noopener" class="be-card" data-cursor="view" data-cursor-label="Behance ↗">
            <div class="be-media"><img src={b.img} alt={`Capa do projeto ${b.title}`} width="808" height="632" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>
            <span class="be-tag">{b.tag}</span>
            <h3>{b.title}</h3>
            <span class="be-meta">{b.stats}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="container be-foot">
    <a href={site.social[0].href} target="_blank" rel="noopener" class="btn btn--ghost" data-magnetic>Ver perfil no Behance <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .behance { overflow: hidden; }
  .be-stats { display: flex; gap: 32px; flex-wrap: wrap; }
  .be-stats div { display: grid; }
  .be-stats b { font-family: var(--font-display); font-size: 32px; letter-spacing: -0.03em; font-weight: 600; }
  .be-stats span { font-size: 14px; color: var(--ink-3); }
  .be-rail { overflow-x: auto; scrollbar-width: none; cursor: grab; scroll-snap-type: x proximity; scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2)); }
  .be-rail::-webkit-scrollbar { display: none; }
  .be-rail.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .be-rail.is-dragging a { pointer-events: none; }
  .be-track {
    display: flex; gap: 20px; list-style: none; margin: 0;
    padding: 4px max(var(--gutter), calc((100vw - var(--max)) / 2)) 20px;
    width: max-content;
  }
  .be-track li { width: clamp(260px, 30vw, 380px); scroll-snap-align: start; }
  .be-card { display: grid; gap: 10px; }
  .be-media { aspect-ratio: 808 / 632; border-radius: 16px; overflow: hidden; background: var(--bg-soft); box-shadow: 0 0 0 1px var(--line); }
  .be-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); user-select: none; -webkit-user-drag: none; }
  .be-card:hover .be-media img { transform: scale(1.05); }
  .be-tag { font-family: var(--font-pixel); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--forest); margin-top: 6px; }
  .be-card h3 { font-size: 1.25rem; letter-spacing: -0.02em; }
  .be-meta { font-size: 14px; color: var(--ink-3); }
  .be-foot { margin-top: 20px; }
</style>
