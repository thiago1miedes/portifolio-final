---
// Moldura de navegador. mode:
//  - "scroll": a página rola dentro da janela (roda do mouse / toque)
//  - "scrub":  a imagem rola junto com a rolagem da página (GSAP)
//  - "auto":   rolagem automática em loop
//  - "static": só o topo da página
interface Props {
  src: string; w: number; h: number; alt: string;
  url?: string; mode?: "scroll" | "scrub" | "auto" | "static";
  ratio?: string; class?: string; eager?: boolean;
}
const { src, w, h, alt, url = "", mode = "scroll", ratio = "16 / 10", class: cls = "", eager = false } = Astro.props;
---
<figure class:list={["browser", `browser--${mode}`, cls]} data-browser={mode}>
  <div class="browser-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {url && <span class="browser-url">{url}</span>}
    <span class="browser-tail" aria-hidden="true"></span>
  </div>
  <div class="browser-view" style={`aspect-ratio:${ratio}`} data-lenis-prevent={mode === "scroll" ? "" : undefined} tabindex={mode === "scroll" ? 0 : undefined}>
    <img class="browser-shot" src={src} width={w} height={h} alt={alt} loading={eager ? "eager" : "lazy"} decoding="async" />
  </div>
</figure>

<style>
  .browser {
    margin: 0;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line), var(--shadow-lg);
  }
  .browser-bar {
    display: flex; align-items: center; gap: 14px;
    height: 38px; padding: 0 14px;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }
  .dots { display: flex; gap: 6px; flex: none; }
  .dots i { width: 9px; height: 9px; background: var(--line-strong); }
  .dots i:first-child { background: var(--leaf); }
  .dots i:nth-child(2) { background: var(--gem); }
  .browser-url {
    flex: 1; min-width: 0;
    max-width: 360px; margin-inline: auto;
    height: 22px; border-radius: 6px; background: #fff; border: 1px solid var(--line);
    font-size: 11.5px; color: var(--ink-3); line-height: 20px; text-align: center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-inline: 10px;
  }
  .browser-tail { width: 45px; flex: none; }
  .browser-view { position: relative; width: 100%; overflow: hidden; background: #fff; }
  .browser-shot { width: 100%; height: auto; max-width: none; will-change: transform; }
  .browser--scroll .browser-view { overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .browser--auto .browser-shot { animation: browser-auto 38s ease-in-out infinite alternate; }
  @keyframes browser-auto { from { transform: translateY(0); } to { transform: translateY(calc(-100% + var(--view-h, 420px))); } }
  @media (prefers-reduced-motion: reduce) { .browser--auto .browser-shot { animation: none; } }
</style>
