---
import { categories, type Case } from "../data/cases";
import { capaOf } from "../data/capas";
interface Props { c: Case }
const { c } = Astro.props;
const cover = capaOf(c.slug) ?? c.thumb;
---
<a href={`/cases/${c.slug}/`} class="case-card" data-cats={c.cats.join(" ")} data-project={c.slug} data-flip-id={c.slug}>
  <div class="cc-media">
    <img src={cover.src} width={cover.w} height={cover.h} alt={`Projeto ${c.title}`} loading="lazy" decoding="async" />
  </div>
  <div class="cc-info">
    <h3 class="cc-title">{c.title}</h3>
    <p class="cc-cat">{categories[c.cats[0]]}</p>
    <p class="cc-sector">{c.sector}</p>
  </div>
</a>

<style>
  .case-card { display: grid; gap: 14px; align-content: start; }
  :global(.js) .case-card { opacity: 0; }
  .cc-media {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-elev);
    outline: 1px solid var(--border);
    outline-offset: -1px;
  }
  .cc-media img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.4s; }
  .case-card:hover .cc-media img { opacity: 0.86; }
  .cc-info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3px 16px;
    align-items: baseline;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .cc-title { font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; transition: color 0.3s; }
  .cc-cat { font-size: 0.8125rem; color: var(--text-muted); white-space: nowrap; }
  .cc-sector { grid-column: 1 / -1; font-size: 0.875rem; line-height: 1.35; color: var(--text-muted); }
  .case-card:hover .cc-title { color: var(--accent); }
</style>
