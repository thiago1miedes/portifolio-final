---
import Icon from "./Icon.astro";
import { categories, type Case } from "../data/cases";
interface Props { c: Case }
const { c } = Astro.props;
---
<a href={`/cases/${c.slug}/`} class="case-card" data-cursor="view" data-cats={c.cats.join(" ")} data-project={c.slug} data-flip-id={c.slug}>
  <div class="cc-media">
    <img src={c.thumb.src} width={c.thumb.w} height={c.thumb.h} alt={`Projeto ${c.title}`} loading="lazy" decoding="async" />
  </div>
  <div class="cc-info">
    <div>
      <h3 class="cc-title">{c.title}</h3>
      <p class="cc-cat">{c.cats.slice(0, 2).map((k) => categories[k]).join(" · ")}</p>
    </div>
    <span class="cc-arrow" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
  </div>
</a>

<style>
  .case-card { display: grid; gap: 16px; align-content: start; }
  :global(.js) .case-card { opacity: 0; }
  .cc-media {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    isolation: isolate;
  }
  .cc-media img { width: 100%; height: 100%; object-fit: cover; transition: scale 0.9s var(--ease); }
  .case-card:hover .cc-media img { scale: 1.04; }
  .cc-info { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding-inline: 2px; }
  .cc-title { font-size: 1.3125rem; letter-spacing: -0.03em; transition: color 0.3s; }
  .cc-cat { margin-top: 4px; font-size: 0.875rem; color: var(--text-muted); }
  .cc-arrow {
    flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
    border: 1px solid var(--border); color: var(--text);
    transition: background-color 0.35s, color 0.35s, border-color 0.35s, transform 0.45s var(--ease);
  }
  .case-card:hover .cc-title { color: var(--accent); }
  .case-card:hover .cc-arrow { background: var(--accent); border-color: var(--accent); color: var(--on-accent); transform: rotate(45deg); }
</style>
