---
import { categories, type Case } from "../data/cases";
interface Props { c: Case; index?: number }
const { c } = Astro.props;
---
<a href={`/cases/${c.slug}/`} class="case-card" data-cursor="view" data-cats={c.cats.join(" ")} style={`--accent:${c.accent}`} data-flip-id={c.slug}>
  <div class="cc-media">
    <img src={c.thumb.src} width={c.thumb.w} height={c.thumb.h} alt={`Capa do projeto ${c.title}`} loading="lazy" decoding="async" />
    <span class="cc-corner" aria-hidden="true"></span>
  </div>
  <div class="cc-info">
    <div class="cc-title-row">
      <h3 class="cc-title">{c.title}</h3>
      <span class="cc-arrow" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" /></svg>
      </span>
    </div>
    <p class="cc-sector">{c.sector}</p>
    <div class="cc-tags">
      {c.cats.slice(0, 2).map((k) => <span class="chip chip--pixel">{categories[k]}</span>)}
      {c.live && <span class="chip chip--live"><i></i>No ar</span>}
    </div>
  </div>
</a>

<style>
  .case-card { display: grid; gap: 16px; align-content: start; }
  .cc-media {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: 18px;
    overflow: hidden;
    background: var(--bg-soft);
    box-shadow: 0 0 0 1px var(--line);
    isolation: isolate;
  }
  .cc-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .case-card:hover .cc-media img { transform: scale(1.05); }
  .cc-corner {
    position: absolute; right: 0; bottom: 0; width: 48px; height: 48px;
    background:
      linear-gradient(var(--accent), var(--accent)) 100% 100% / 16px 16px no-repeat,
      linear-gradient(var(--accent), var(--accent)) 100% 66.6% / 16px 16px no-repeat,
      linear-gradient(var(--accent), var(--accent)) 66.6% 100% / 16px 16px no-repeat;
    opacity: 0; transform: translate(8px, 8px);
    transition: opacity 0.35s, transform 0.45s var(--ease);
  }
  .case-card:hover .cc-corner { opacity: 1; transform: none; }
  .cc-info { display: grid; gap: 8px; padding-inline: 4px; }
  .cc-title-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .cc-title { font-size: 1.45rem; letter-spacing: -0.03em; }
  .cc-arrow {
    flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong); color: var(--ink);
    transition: background-color 0.35s, color 0.35s, transform 0.45s var(--ease), box-shadow 0.35s;
  }
  .case-card:hover .cc-arrow { background: var(--ink); color: #fff; box-shadow: none; transform: rotate(45deg); }
  .cc-sector { font-size: 14.5px; color: var(--ink-3); }
  .cc-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
</style>
