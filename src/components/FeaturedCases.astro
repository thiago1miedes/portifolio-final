---
import { featured, categories } from "../data/cases";
const total = String(featured.length).padStart(2, "0");
---
<section class="section featured" id="cases">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <span class="eyebrow" data-reveal>Cases em destaque</span>
        <h2 class="h-section" data-split style="margin-top:18px">Projetos que unem <span class="hl">design</span> e <span class="hl-marine">resultado</span>.</h2>
      </div>
      <p class="lead" data-reveal>Uma seleção de sites, identidades e campanhas — do layout no Figma ao site publicado. Clique em qualquer projeto para ver o case completo.</p>
    </div>

    <div class="stack" data-stack>
      {featured.map((c, i) => {
        const page = c.items.find((it) => it.kind === "page");
        const visual = page ?? c.thumb;
        return (
          <article class="stack-card" style={`--accent:${c.accent}`} data-stack-card>
            <a href={`/cases/${c.slug}/`} class="stack-link" data-cursor="view" aria-label={`Ver case ${c.title}`}></a>
            <div class="stack-info">
              <div class="stack-top">
                <span class="stack-num">{String(i + 1).padStart(2, "0")}<small>/{total}</small></span>
                <span class="stack-dot" aria-hidden="true"></span>
              </div>
              <div class="stack-body">
                <div class="stack-cats">{c.cats.slice(0, 3).map((k) => <span class="chip chip--pixel">{categories[k]}</span>)}</div>
                <h3 class="stack-title">{c.title}</h3>
                <p class="stack-summary">{c.summary}</p>
                <ul class="stack-list">{c.deliverables.slice(0, 4).map((d) => <li>{d}</li>)}</ul>
              </div>
              <span class="stack-cta">Ver case completo <i aria-hidden="true">→</i></span>
            </div>
            <div class="stack-media">
              {page ? (
                <div class="stack-browser">
                  <div class="sb-bar"><i></i><i></i><i></i></div>
                  <div class="sb-view">
                    <img src={page.src} width={page.w} height={page.h} alt={`Layout do site ${c.title}`} loading="lazy" decoding="async" />
                  </div>
                </div>
              ) : visual && (
                <img class="stack-img" src={visual.src} width={visual.w} height={visual.h} alt={`Projeto ${c.title}`} loading="lazy" decoding="async" />
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .featured { padding-bottom: clamp(32px, 4vw, 56px); }
  .stack { display: grid; gap: 28px; }
  .stack-card {
    position: relative;
    display: grid;
    gap: 24px;
    padding: clamp(16px, 2vw, 24px);
    border-radius: 28px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    overflow: hidden;
    transform-origin: 50% 0;
  }
  .stack-card::before {
    /* brilho na cor do cliente */
    content: ""; position: absolute; inset: auto -10% -40% auto; width: 60%; aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 65%);
    pointer-events: none;
  }
  .stack-link { position: absolute; inset: 0; z-index: 3; border-radius: inherit; }
  .stack-info { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 28px; padding: clamp(8px, 1.5vw, 20px); }
  .stack-top { display: flex; align-items: center; justify-content: space-between; }
  .stack-num { font-family: var(--font-pixel); font-size: 15px; color: var(--forest); letter-spacing: 0.04em; }
  .stack-num small { color: var(--ink-3); font-size: 13px; }
  .stack-dot { width: 14px; height: 14px; background: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 22%, transparent); }
  .stack-body { display: grid; gap: 16px; }
  .stack-cats { display: flex; flex-wrap: wrap; gap: 6px; }
  .stack-title { font-size: clamp(2.2rem, 4.4vw, 4rem); letter-spacing: -0.045em; }
  .stack-summary { color: var(--ink-2); font-size: 17px; max-width: 46ch; }
  .stack-list { list-style: none; padding: 0; margin: 4px 0 0; display: grid; gap: 8px; }
  .stack-list li { display: flex; align-items: center; gap: 10px; font-size: 15px; color: var(--ink-2); }
  .stack-list li::before { content: ""; width: 6px; height: 6px; background: var(--leaf); flex: none; }
  .stack-cta {
    margin-top: auto;
    display: inline-flex; align-items: center; gap: 10px; align-self: flex-start;
    font-family: var(--font-display); font-weight: 600; color: var(--ink);
    padding: 12px 20px; border-radius: 999px; background: #fff; box-shadow: 0 0 0 1px var(--line);
    transition: background-color 0.35s, color 0.35s;
  }
  .stack-cta i { font-style: normal; transition: transform 0.35s var(--ease); }
  .stack-card:hover .stack-cta { background: var(--ink); color: #fff; }
  .stack-card:hover .stack-cta i { transform: translateX(4px); }

  .stack-media { position: relative; z-index: 1; min-height: 0; }
  @media (max-width: 999px) { .stack-media { order: -1; } .stack-info { gap: 20px; } }
  @media (max-width: 640px) { .stack-list { display: none; } .stack-title { font-size: 2rem; } .stack-card { border-radius: 22px; } }
  .stack-browser { height: 100%; border-radius: 16px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px var(--line), var(--shadow); display: flex; flex-direction: column; }
  .sb-bar { display: flex; gap: 6px; padding: 12px 14px; border-bottom: 1px solid var(--line); background: #fff; flex: none; }
  .sb-bar i { width: 8px; height: 8px; background: var(--line-strong); }
  .sb-bar i:first-child { background: var(--leaf); }
  .sb-view { position: relative; overflow: hidden; aspect-ratio: 16 / 10; flex: 1; }
  .sb-view img { width: 100%; max-width: none; transform-origin: 50% 0; transition: transform 1.2s var(--ease); }
  .stack-card:hover .sb-view img { transform: scale(1.025); }
  .stack-img { width: 100%; height: 100%; object-fit: cover; border-radius: 16px; box-shadow: var(--shadow); aspect-ratio: 16 / 10; }
  .stack-card:hover .stack-img { transform: scale(1.015); }
  .stack-img { transition: transform 0.8s var(--ease); }

  @media (min-width: 1000px) {
    .stack { gap: 0; }
    .stack-card {
      position: sticky;
      top: 96px;
      height: min(78vh, 720px);
      grid-template-columns: 0.78fr 1.22fr;
      margin-bottom: 3vh;
    }
    .sb-view { aspect-ratio: auto; }
    .stack-img { aspect-ratio: auto; }
  }
</style>
