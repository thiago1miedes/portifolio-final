---
import Icon from "./Icon.astro";
import { site, nav, whatsappUrl } from "../data/site";
const year = new Date().getFullYear();
const letters = site.firstName.toUpperCase().split("");
---
<footer class="footer" id="contato">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container footer-inner">
    <div class="footer-cta">
      <p class="eyebrow" data-reveal>Contato</p>
      <h2 class="title-section footer-title" data-split>Vamos <em>criar</em> algo incrível juntos.</h2>
      <a href={whatsappUrl} class="btn btn--accent" target="_blank" rel="noopener" data-reveal>Começar um projeto <Icon name="arrow-up-right" class="icon--arrow" /></a>
    </div>

    <div class="footer-cols">
      <div class="footer-col">
        <h3>E-mail</h3>
        <a href={`mailto:${site.email}`} class="footer-link">{site.email}</a>
      </div>
      <div class="footer-col">
        <h3>WhatsApp</h3>
        <a href={whatsappUrl} target="_blank" rel="noopener" class="footer-link">{site.phone}</a>
      </div>
      <div class="footer-col">
        <h3>Redes</h3>
        <ul class="socials">
          {site.social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" class="social" aria-label={s.label}>
                <Icon name={s.icon} size={22} />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h3>Menu</h3>
        <ul class="footer-menu">
          {nav.map((n) => <li><a href={n.href} class="footer-link">{n.label}</a></li>)}
          <li><a href="/cases/" class="footer-link">Todos os projetos</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}. Todos os direitos reservados.</p>
      <p>{site.city} — Brasil</p>
    </div>
  </div>

  <div class="footer-name display" aria-hidden="true" data-footer-name>
    {letters.map((l) => <span class="footer-letter" data-letter>{l}</span>)}
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(80px, 10vw, 150px);
    overflow: hidden;
    border-top: 1px solid var(--border);
    isolation: isolate;
    container-type: inline-size;
  }
  .footer-glow {
    position: absolute;
    left: 50%; bottom: -30%;
    width: min(1200px, 160vw);
    aspect-ratio: 2 / 1;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(255, 90, 31, 0.2), transparent 75%);
    z-index: -1;
    pointer-events: none;
  }
  .footer-inner { display: grid; gap: clamp(48px, 6vw, 88px); }
  .footer-cta { display: grid; gap: 24px; justify-items: start; }
  .footer-title { max-width: 13ch; font-size: clamp(2.75rem, 7.4vw, 6.5rem); }

  .footer-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px; }
  @media (min-width: 900px) { .footer-cols { grid-template-columns: 1.3fr 1fr 1fr 1fr; } }
  .footer-col { display: grid; gap: 14px; align-content: start; }
  .footer-col:first-child { grid-column: 1 / -1; }
  @media (min-width: 900px) { .footer-col:first-child { grid-column: auto; } }
  .footer-col h3 {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .footer-link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    transition: color 0.3s;
  }
  .footer-link:hover { color: var(--accent); }
  .footer-menu { display: grid; gap: 6px; }
  .footer-menu .footer-link { font-size: 1rem; font-weight: 500; color: var(--text-muted); }
  .footer-menu .footer-link:hover { color: var(--text); }

  .socials { display: flex; gap: 10px; }
  .social {
    display: grid; place-items: center;
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), background-color 0.3s;
  }
  .social:hover { transform: translateY(-3px); background: var(--accent-hover); box-shadow: 0 12px 28px -8px var(--accent-glow); }

  .footer-bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  /* THIAGO gigante, cortado pela borda inferior */
  .footer-name {
    display: flex;
    justify-content: space-between;
    margin-top: clamp(16px, 2vw, 32px);
    padding-inline: clamp(8px, 1.5vw, 24px);
    height: 0.62em;
    /* THIAGO ocupa 100% da largura */
    font-size: calc((100cqi - 2 * clamp(8px, 1.5cqi, 24px)) / 2.62);
    line-height: 0.82;
    color: var(--accent);
    overflow: hidden;
    user-select: none;
  }
  .footer-letter { display: block; }
</style>
