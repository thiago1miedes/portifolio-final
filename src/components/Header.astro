---
import Icon from "./Icon.astro";
import { site, nav, whatsappUrl } from "../data/site";
---
<header class="nav" data-nav>
  <div class="nav-pill">
    <a href="/" class="nav-brand" aria-label={`${site.name}, início`}>
      <img class="nav-avatar" src="/about/avatar.webp" width="80" height="80" alt="" />
      <span>{site.firstName}</span>
    </a>

    <nav class="nav-links" aria-label="Principal">
      {nav.map((n) => <a href={n.href} class="nav-link" data-nav-link={n.section}>{n.label}</a>)}
    </nav>

    <a href="/#contato" class="btn btn--accent btn--sm nav-cta">Contato</a>

    <button class="nav-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-panel" data-menu-toggle>
      <span></span><span></span>
    </button>
  </div>

  <div class="nav-panel is-hidden" id="nav-panel" data-menu-panel>
    <nav aria-label="Menu">
      <ul class="panel-links">
        {nav.map((n) => (
          <li><a href={n.href} class="panel-link" data-menu-link>{n.label}</a></li>
        ))}
        <li><a href="/cases/" class="panel-link" data-menu-link>Todos os projetos</a></li>
      </ul>
    </nav>
    <div class="panel-foot">
      <a href="/#contato" class="btn btn--accent" data-menu-link>Contato <Icon name="arrow-up-right" class="icon--arrow" /></a>
      <a href={whatsappUrl} class="btn btn--ghost" target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 14px;
    left: 50%;
    z-index: 100;
    width: min(100% - 24px, 820px);
    transform: translateX(-50%);
    transition: width 0.5s var(--ease), top 0.5s var(--ease);
  }
  .nav-pill {
    display: flex;
    align-items: center;
    gap: 12px;
    height: var(--nav-h);
    padding: 0 8px 0 8px;
    border-radius: var(--radius-pill);
    background: rgba(19, 19, 22, 0.62);
    border: 1px solid var(--border);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: 0 10px 40px -18px rgba(0, 0, 0, 0.8);
    transition: height 0.5s var(--ease), background-color 0.4s;
  }
  /* ao rolar, a navbar encolhe levemente */
  .nav.is-scrolled { top: 10px; width: min(100% - 24px, 760px); }
  .nav.is-scrolled .nav-pill { height: 56px; background: rgba(19, 19, 22, 0.78); }
  .nav.is-scrolled .nav-avatar { width: 38px; height: 38px; }

  .nav-brand {
    display: inline-flex; align-items: center; gap: 10px;
    margin-right: auto;
    padding-right: 10px;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }
  .nav-avatar {
    width: 46px; height: 46px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.08);
    transition: width 0.5s var(--ease), height 0.5s var(--ease);
  }

  .nav-links { display: none; gap: 2px; }
  .nav-link {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.3s, background-color 0.3s;
  }
  .nav-link:hover, .nav-link.is-active { color: var(--text); background: var(--surface-glass-2); }
  .nav-cta { display: none; }

  .nav-toggle {
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--surface-glass-2);
    border: 1px solid var(--border);
    display: grid; place-content: center; gap: 6px;
    transition: background-color 0.3s;
  }
  .nav-toggle:hover { background: rgba(255, 255, 255, 0.12); }
  .nav-toggle span { display: block; width: 18px; height: 2px; border-radius: 2px; background: var(--text); transition: transform 0.4s var(--ease); }
  .nav-toggle[aria-expanded="true"] span:first-child { transform: translateY(4px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:last-child { transform: translateY(-4px) rotate(-45deg); }

  @media (min-width: 900px) {
    .nav-links { display: flex; }
    .nav-cta { display: inline-flex; }
    .nav-toggle { display: none; }
  }

  /* painel do menu (mobile): display:none ↔ flex pela classe .is-hidden */
  .nav-panel {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 8px;
    padding: 20px;
    max-height: calc(100svh - 110px);
    overflow: auto;
    border-radius: var(--radius-lg);
    background: rgba(19, 19, 22, 0.92);
    border: 1px solid var(--border);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .panel-links { display: grid; }
  .panel-link {
    display: flex; align-items: baseline; gap: 14px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 2.6rem);
    line-height: 1;
    text-transform: uppercase;
    transition: color 0.3s;
  }
  .panel-link:hover { color: var(--accent); }
  .panel-foot { display: flex; flex-wrap: wrap; gap: 10px; }
  .panel-foot .btn { flex: 1 1 140px; }
</style>
