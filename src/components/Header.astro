---
import Logo from "./Logo.astro";
import { site } from "../data/site";
const path = Astro.url.pathname;
const nav = [
  { href: "/#cases", label: "Cases" },
  { href: "/cases/", label: "Projetos" },
  { href: "/#servicos", label: "Serviços" },
  { href: "/#sobre", label: "Sobre" },
  { href: "/#contato", label: "Contato" },
];
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="header-logo" aria-label="Thiago Miedes — início"><Logo /></a>

    <nav class="header-nav" aria-label="Principal">
      {nav.map((n) => (
        <a href={n.href} class:list={["nav-link", { "is-active": n.href === "/cases/" && path.startsWith("/cases") }]}>
          <span>{n.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <span class="status"><i></i>Disponível para projetos</span>
      <a href="/#contato" class="btn btn--sm header-cta">Vamos conversar</a>
      <button class="burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav class="container menu-nav" aria-label="Menu">
      {nav.map((n, i) => (
        <a href={n.href} class="menu-link"><small>0{i + 1}</small>{n.label}</a>
      ))}
    </nav>
    <div class="container menu-foot">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    transition: transform 0.5s var(--ease), background-color 0.4s, box-shadow 0.4s;
  }
  .site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header.is-hidden { transform: translateY(-100%); }
  .header-inner {
    height: 76px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .header-nav { display: none; gap: 4px; }
  .nav-link {
    position: relative;
    padding: 8px 14px;
    font-family: var(--font-display);
    font-weight: 500; font-size: 15.5px;
    color: var(--ink-2);
    border-radius: 999px;
    transition: color 0.3s, background-color 0.3s;
  }
  .nav-link:hover, .nav-link.is-active { color: var(--ink); background: var(--bg-soft); }
  .nav-link::after {
    content: ""; position: absolute; left: 50%; bottom: 2px;
    width: 4px; height: 4px; background: var(--leaf);
    transform: translateX(-50%) scale(0);
    transition: transform 0.3s var(--ease);
  }
  .nav-link:hover::after, .nav-link.is-active::after { transform: translateX(-50%) scale(1); }

  .header-actions { display: flex; align-items: center; gap: 14px; }
  .status {
    display: none; align-items: center; gap: 8px;
    font-size: 13.5px; color: var(--ink-2);
  }
  .status i {
    width: 8px; height: 8px; background: var(--leaf);
    box-shadow: 0 0 0 4px var(--mint);
    animation: blink 2.4s steps(2, jump-none) infinite;
  }
  @keyframes blink { 50% { box-shadow: 0 0 0 0 var(--mint); } }
  .header-cta { display: none; }

  .burger {
    width: 46px; height: 46px; border: 0; border-radius: 50%;
    background: var(--ink);
    display: grid; place-content: center; gap: 6px;
  }
  .burger span { display: block; width: 18px; height: 2px; background: #fff; transition: transform 0.4s var(--ease); }
  .burger[aria-expanded="true"] span:first-child { transform: translateY(4px) rotate(45deg); }
  .burger[aria-expanded="true"] span:last-child { transform: translateY(-4px) rotate(-45deg); }

  @media (min-width: 1000px) {
    .header-nav { display: flex; }
    .header-cta { display: inline-flex; }
    .burger { display: none; }
  }
  @media (min-width: 1240px) { .status { display: inline-flex; } }

  .menu {
    position: fixed; inset: 76px 0 0 0;
    background: #fff;
    display: flex; flex-direction: column; justify-content: space-between;
    padding-block: 32px 40px;
    overflow: auto;
  }
  .menu[hidden] { display: none; }
  .menu-nav { display: grid; gap: 6px; }
  .menu-link {
    display: flex; align-items: baseline; gap: 14px;
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(2.2rem, 10vw, 3.4rem);
    letter-spacing: -0.04em; line-height: 1.15;
    border-bottom: 1px solid var(--line);
    padding-block: 8px;
  }
  .menu-link small { font-family: var(--font-pixel); font-size: 13px; color: var(--forest); letter-spacing: 0; }
  .menu-foot { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 32px; color: var(--ink-2); }
</style>
