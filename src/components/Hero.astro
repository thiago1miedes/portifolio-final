---
import Icon from "./Icon.astro";
import Marquee from "./Marquee.astro";
import { facts, skills } from "../data/site";
---
<section class="hero" id="inicio" data-hero>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-stage">
      <h1 class="hero-title display" aria-label="Pense criativamente">
        <span class="hero-line" aria-hidden="true"><span class="hero-word" data-hero-line>Pense</span></span>
        <span class="hero-line hero-line--accent" aria-hidden="true"><span class="hero-word" data-hero-line>Criativamente</span></span>
      </h1>

      <p class="hero-tag" data-hero-fade>
        <span class="status"><i></i>Disponível para novos projetos</span>
        <span class="hero-role">Designer gráfico &amp; web designer</span>
      </p>

      <figure class="hero-avatar" data-hero-avatar>
        <img
          src="/about/thiago-cutout.webp"
          width="612" height="984"
          alt="Thiago Miedes de braços cruzados, vestindo blusa preta"
          fetchpriority="high"
          data-parallax="0.04"
        />
      </figure>
    </div>

    <div class="hero-bottom">
      <div class="hero-intro" data-hero-fade>
        <p>Designer gráfico e web designer. Eu transformo ideias em marcas e experiências digitais claras e memoráveis.</p>
        <a href="#contato" class="btn btn--accent">Vamos conversar <Icon name="arrow-up-right" class="icon--arrow" /></a>
      </div>

      <ul class="hero-facts" data-hero-fade>
        {facts.map((f) => (
          <li><strong>{f.value}</strong><span>{f.label}</span></li>
        ))}
      </ul>
    </div>
  </div>

  <Marquee items={skills} />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--nav-h) + 48px);
    overflow: hidden;
    isolation: isolate;
  }
  /* brilho laranja sutil no fundo */
  .hero-glow {
    position: absolute;
    left: 50%; top: 58%;
    width: min(1100px, 140vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(255, 90, 31, 0.22), rgba(255, 90, 31, 0.06) 55%, transparent 72%);
    pointer-events: none;
    z-index: -1;
  }

  /* tudo no hero é medido pela largura (cqi): a composição fica igual em qualquer tela */
  .hero-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    container-type: inline-size;
  }

  /* palco: título gigante + avatar na frente */
  .hero-stage {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .hero-title {
    position: relative;
    z-index: 1;
    display: grid;
    /* CRIATIVAMENTE ocupa toda a largura do container */
    font-size: calc(100cqi / 5.7);
    line-height: 0.86;
  }
  .hero-line { display: block; overflow: clip; padding-top: 0.04em; }
  .hero-word { display: block; }
  .hero-line--accent { color: var(--accent); }

  .hero-tag {
    order: -1;
    display: grid;
    gap: 6px;
    margin-bottom: 18px;
  }
  .hero-role { display: none; font-family: var(--font-heading); font-weight: 600; font-size: clamp(1rem, 1.7cqi, 1.5rem); letter-spacing: -0.02em; line-height: 1.2; }

  .hero-avatar {
    position: relative;
    z-index: 2;
    width: min(74%, 340px);
    margin: -9cqi auto 0;
    pointer-events: none;
  }
  .hero-avatar img {
    width: 100%;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.55));
    /* some suavemente na base para encostar no conteúdo de baixo */
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
  }

  .hero-bottom {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 28px;
    margin-top: -16cqi;
    padding-bottom: 32px;
  }
  .hero-intro { display: grid; gap: 20px; justify-items: start; max-width: 380px; }
  .hero-intro p { color: var(--text-muted); font-size: 1.0625rem; line-height: 1.55; }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .hero-facts li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding-top: 14px;
    border-top: 1px solid var(--border-strong);
  }
  .hero-facts strong {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2.2vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .hero-facts li:first-child strong { color: var(--accent); }
  .hero-facts span { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.35; }

  /* mobile: PENSE também ocupa a largura toda; fatos em lista */
  @media (max-width: 699px) {
    .hero-line:first-child { font-size: calc(100cqi / 2.3); line-height: 0.84; }
    .hero-avatar { width: min(68%, 320px); }
    .hero-facts { grid-template-columns: 1fr; gap: 0; }
    .hero-facts li { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-block: 12px; }
    .hero-facts span { text-align: right; }
  }

  /* desktop: avatar no centro, sobrepondo as letras; texto e fatos nas laterais */
  @media (min-width: 700px) {
    .hero { padding-top: calc(var(--nav-h) + 40px); }
    .hero-stage { display: block; height: 50cqi; }
    .hero-tag {
      position: absolute;
      z-index: 3;
      right: 0;
      top: 0;
      justify-items: end;
      max-width: 34cqi;
      margin: 0;
      padding-top: 1.2cqi;
      text-align: right;
    }
    .hero-role { display: block; }
    .hero-avatar {
      position: absolute;
      left: 0;
      right: 0;
      top: 4.5cqi;
      width: 28.4cqi;
      margin: 0 auto;
    }
    .hero-bottom {
      grid-template-columns: minmax(0, 1fr) 28cqi minmax(0, 1fr);
      align-items: end;
      gap: 24px;
    }
    .hero-intro { grid-column: 1; }
    .hero-facts { grid-column: 3; grid-template-columns: 1fr; gap: 14px; justify-self: end; width: min(100%, 280px); }
  }
</style>
