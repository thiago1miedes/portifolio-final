---
import Icon from "./Icon.astro";
import Marquee from "./Marquee.astro";
import Sticker from "./Sticker.astro";
import { facts, skills, heroPhrases } from "../data/site";
---
<section class="hero" id="inicio" data-hero>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-stage">
      <h1 class="hero-title display" aria-label="Pense criativamente">
        <span class="hero-line" aria-hidden="true"><span class="hero-word" data-hero-line>Pense</span></span>
        <span class="hero-line hero-line--accent" aria-hidden="true"><span class="hero-word" data-hero-line>Criativamente</span></span>
      </h1>

      <p class="hero-tag" data-hero-fade>
        <span class="hero-role">Designer gráfico &amp; web designer</span>
      </p>

      <figure class="hero-avatar" data-hero-avatar>
        <div class="hero-tilt" data-avatar-tilt>
          <img
            src="/about/thiago-cutout.webp"
            width="612" height="984"
            alt="Thiago Miedes de braços cruzados, vestindo blusa preta"
            fetchpriority="high"
            data-parallax="0.04"
          />
          <!-- a foto aparece selecionada, como numa tela do Figma: a bolinha de cima gira -->
          <div class="selbox" data-selbox aria-hidden="true">
            <i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i>
            <span class="selbox-rotate" data-avatar-rotate></span>
            <span class="selbox-tag">Thiago Miedes</span>
          </div>
        </div>
      </figure>

      <button type="button" class="hero-say" data-say data-phrases={JSON.stringify(heroPhrases.all)} data-phrases-mouse={JSON.stringify(heroPhrases.mouse)} aria-label="Trocar a frase do balão">
        <span class="hero-say-bubble" data-say-text>{heroPhrases.all[0]}</span>
      </button>

      <Sticker name="spark" x="74cqi" y="7cqi" size="6.5cqi" r={12} depth={0.05} mx="82cqi" my="28cqi" msize="46px" />
      <Sticker name="swatch" x="88cqi" y="10.5cqi" size="6.6cqi" r={9} depth={0.025} mx="3cqi" my="68cqi" msize="54px" />
      <Sticker name="nib" tone="ink" x="30cqi" y="13.5cqi" size="6cqi" r={-14} depth={-0.03} mx="6cqi" my="92cqi" msize="46px" />
      <Sticker name="smile" x="29cqi" y="28.5cqi" size="5.6cqi" r={-10} depth={0.04} mx="84cqi" my="66cqi" msize="48px" />
    </div>

    <div class="hero-bottom">
      <div class="hero-intro" data-hero-fade>
        <p>Identidades visuais, sites e redes sociais para marcas que querem ser lembradas. Cada projeto começa entendendo o seu negócio.</p>
        <a href="#contato" class="btn btn--accent">Vamos conversar <Icon name="arrow-up-right" class="icon--arrow" /></a>
      </div>

      <ul class="hero-facts" data-hero-fade>
        {facts.map((f) => (
          <li><strong>{f.value}</strong><span>{f.label}</span></li>
        ))}
      </ul>
    </div>
  </div>

  <Marquee items={skills} />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--nav-h) + 48px);
    overflow: hidden;
    isolation: isolate;
  }
  /* brilho laranja sutil no fundo */
  .hero-glow {
    position: absolute;
    left: 50%; top: 58%;
    width: min(1100px, 140vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(255, 90, 31, 0.22), rgba(255, 90, 31, 0.06) 55%, transparent 72%);
    pointer-events: none;
    z-index: -1;
  }

  /* tudo no hero é medido pela largura (cqi): a composição fica igual em qualquer tela */
  .hero-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    container-type: inline-size;
  }

  /* palco: título gigante + avatar na frente */
  .hero-stage {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .hero-title {
    position: relative;
    z-index: 1;
    display: grid;
    /* CRIATIVAMENTE ocupa toda a largura do container */
    font-size: calc(100cqi / 5.7);
    line-height: 0.86;
  }
  .hero-line { display: block; overflow: clip; padding-top: 0.04em; }
  .hero-word { display: block; }
  .hero-line--accent { color: var(--accent); }

  .hero-tag {
    order: -1;
    display: grid;
    gap: 6px;
    margin-bottom: 18px;
  }
  .hero-role { display: none; font-family: var(--font-heading); font-weight: 600; font-size: clamp(1rem, 1.7cqi, 1.5rem); letter-spacing: -0.02em; line-height: 1.2; }

  .hero-avatar {
    position: relative;
    z-index: 2;
    width: min(74%, 340px);
    margin: -9cqi auto 0;
    pointer-events: none;
  }
  .hero-avatar img {
    width: 100%;
  }
  .hero-tilt { position: relative; transform: rotate(-4deg); transform-origin: 50% 70%; }

  /* caixa de seleção sobre a foto */
  .selbox { position: absolute; inset: 1% 3% 12% 3%; border: 1.5px solid var(--accent); pointer-events: none; }
  .selbox i { position: absolute; width: 11px; height: 11px; background: #fff; border: 1.5px solid var(--accent); }
  .selbox .tl { left: -6px; top: -6px; }
  .selbox .tr { right: -6px; top: -6px; }
  .selbox .bl { left: -6px; bottom: -6px; }
  .selbox .br { right: -6px; bottom: -6px; }
  .selbox-rotate {
    position: absolute;
    left: 50%;
    top: -38px;
    width: 18px;
    height: 18px;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid #fff;
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    transition: scale 0.3s var(--ease);
  }
  .selbox-rotate:hover { scale: 1.3; }
  .selbox-rotate:active { cursor: grabbing; }
  .selbox-rotate::after { content: ""; position: absolute; left: 50%; top: 100%; width: 1.5px; height: 20px; margin-left: -0.75px; background: var(--accent); }
  .selbox-tag {
    position: absolute;
    left: 50%;
    bottom: -13px;
    translate: -50% 0;
    padding: 2px 9px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    white-space: nowrap;
  }
  /* no celular não há como girar com precisão: fica só a caixa */
  @media (hover: none) { .selbox-rotate { display: none; } }
  /* no celular o texto sobe por cima do fim da foto: a caixa termina antes dele */
  @media (max-width: 699px) { .selbox { bottom: 27%; } }

  /* balão de fala: cada clique troca a frase */
  .hero-say {
    position: absolute;
    z-index: 5;
    left: 73%;
    top: 40cqi;
    max-width: 44cqi;
  }
  .hero-say-bubble {
    display: block;
    padding: 8px 14px;
    border-radius: 16px 16px 16px 4px;
    background: #f5f2ec;
    color: #0a0a0b;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-align: left;
    rotate: 4deg;
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.6);
    transition: rotate 0.4s var(--ease), scale 0.4s var(--ease);
  }
  .hero-say:hover .hero-say-bubble { rotate: -2deg; scale: 1.06; }
  :global(html.js:not(.no-play)) .hero-say { opacity: 0; }
  @media (min-width: 700px) {
    .hero-say { left: 61.5cqi; top: 8.5cqi; max-width: 15cqi; }
    .hero-say-bubble { font-size: clamp(0.875rem, 1.35cqi, 1.25rem); padding: 0.75cqi 1.2cqi; }
  }

  .hero-bottom {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 28px;
    margin-top: -16cqi;
    padding-bottom: 32px;
  }
  .hero-intro { display: grid; gap: 20px; justify-items: start; max-width: 380px; }
  .hero-intro p { color: var(--text-muted); font-size: 1.0625rem; line-height: 1.55; }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .hero-facts li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding-top: 14px;
    border-top: 1px solid var(--border-strong);
  }
  .hero-facts strong {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2.2vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .hero-facts li:first-child strong { color: var(--accent); }
  .hero-facts span { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.35; }

  /* mobile: PENSE também ocupa a largura toda; fatos em lista */
  @media (max-width: 699px) {
    .hero-line:first-child { font-size: calc(100cqi / 2.3); line-height: 0.84; }
    .hero-avatar { width: min(68%, 320px); }
    .hero-facts { grid-template-columns: 1fr; gap: 0; }
    .hero-facts li { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-block: 12px; }
    .hero-facts span { text-align: right; }
  }

  /* desktop: avatar no centro, sobrepondo as letras; texto e fatos nas laterais */
  @media (min-width: 700px) {
    .hero { padding-top: calc(var(--nav-h) + 40px); }
    .hero-stage { display: block; height: 50cqi; }
    .hero-tag {
      position: absolute;
      z-index: 3;
      right: 0;
      top: 0;
      justify-items: end;
      max-width: 34cqi;
      margin: 0;
      padding-top: 1.2cqi;
      text-align: right;
    }
    .hero-role { display: block; }
    .hero-avatar {
      position: absolute;
      left: 0;
      right: 0;
      top: 4.5cqi;
      width: 28.4cqi;
      margin: 0 auto;
    }
    .hero-bottom {
      grid-template-columns: minmax(0, 1fr) 28cqi minmax(0, 1fr);
      align-items: end;
      gap: 24px;
    }
    .hero-intro { grid-column: 1; }
    .hero-facts { grid-column: 3; grid-template-columns: 1fr; gap: 14px; justify-self: end; width: min(100%, 280px); }
  }
</style>
