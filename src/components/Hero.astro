---
import PixelWorld from "./PixelWorld.astro";
import { cases, countBy } from "../data/cases";
import { site } from "../data/site";

const sb = cases.find((c) => c.slug === "smartbox")!;
const ar = cases.find((c) => c.slug === "arie-capital")!;
const shot = sb.items.find((i) => i.id === "live")!;
const phone = ar.items.find((i) => i.id === "mobile")!;
const sites = countBy("web");
const brands = Math.floor((cases.length + 9) / 5) * 5; // cases da pasta + Behance, arredondado para baixo
---
<section class="hero" data-hero>
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow" data-hero-fade>Web designer & front-end · {site.city}</span>
      <h1 class="h-display hero-title" data-hero-title>
        Do primeiro pixel ao site no ar.
      </h1>
      <p class="lead hero-lead" data-hero-fade>
        Sou Thiago Miedes. Desenho e desenvolvo sites, identidades visuais e conteúdos para marcas que querem ser lembradas — e entrego tudo funcionando, do Figma ao código.
      </p>
      <div class="hero-actions" data-hero-fade>
        <a href="#cases" class="btn btn--green" data-magnetic>
          Ver cases
          <span class="btn-ico" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" /></svg>
          </span>
        </a>
        <a href="#contato" class="btn btn--ghost" data-magnetic>Fale comigo</a>
      </div>
      <dl class="hero-stats" data-hero-fade>
        <div><dt><span data-count={brands}>{brands}</span>+</dt><dd>marcas atendidas</dd></div>
        <div><dt><span data-count={sites}>{sites}</span>+</dt><dd>sites desenhados</dd></div>
        <div><dt><span data-count="790">790</span></dt><dd>avaliações no Behance</dd></div>
      </dl>
    </div>

    <div class="hero-visual" data-hero-visual>
      <a href={`/cases/${sb.slug}/`} class="hv-browser" data-cursor="view" data-depth="18" aria-label="Ver case Smart Box">
        <div class="hv-bar"><i></i><i></i><i></i><span>smartboxbr.com.br</span></div>
        <div class="hv-view">
          <img src={shot.src} width={shot.w} height={shot.h} alt="Site da Smart Box" fetchpriority="high" />
        </div>
      </a>
      <a href={`/cases/${ar.slug}/`} class="hv-phone" data-cursor="view" data-depth="34" aria-label="Ver case Arie Capital">
        <div class="hv-phone-screen">
          <img src={phone.src} width={phone.w} height={phone.h} alt="Site da Arie Capital no celular" loading="lazy" />
        </div>
      </a>
      <span class="hv-tag hv-tag--a" data-depth="48"><i></i>Design + código</span>
      <span class="hv-tag hv-tag--b" data-depth="26">100% responsivo</span>
    </div>
  </div>

  <PixelWorld class="hero-world" />

  <a href="#cases" class="hero-scroll" aria-label="Rolar para os cases">
    <span>Role para explorar</span>
    <svg width="12" height="18" viewBox="0 0 12 18" aria-hidden="true" shape-rendering="crispEdges"><path d="M4 0h4v10h4v2h-2v2H8v2H4v-2H2v-2H0v-2h4z" fill="currentColor" /></svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: clamp(108px, 14vh, 150px);
    padding-bottom: clamp(150px, 21vh, 240px);
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 85% 20%, rgba(78, 224, 194, 0.12), transparent 70%),
      radial-gradient(50% 40% at 10% 10%, rgba(184, 240, 94, 0.12), transparent 70%),
      #fff;
  }
  .hero::before {
    /* grade de pixels sutil ao fundo */
    content: ""; position: absolute; inset: 0;
    background-image:
      linear-gradient(to right, rgba(15, 76, 92, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 76, 92, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(70% 60% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 30%, #000 30%, transparent 75%);
    pointer-events: none;
  }
  .hero-grid { position: relative; z-index: 2; display: grid; gap: 56px; align-items: center; }
  @media (min-width: 1100px) { .hero-grid { grid-template-columns: 1.25fr 0.75fr; gap: 32px; } }

  .hero-copy { display: grid; gap: 24px; justify-items: start; }
  .hero-title { font-size: clamp(2.7rem, 6.3vw, 6.3rem); }
  .hero-lead { max-width: 610px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-stats { display: flex; flex-wrap: wrap; gap: 14px 36px; margin: 8px 0 0; }
  .hero-stats div { display: grid; gap: 2px; }
  .hero-stats dt { font-family: var(--font-display); font-weight: 600; font-size: 30px; letter-spacing: -0.03em; color: var(--ink); }
  .hero-stats dd { margin: 0; font-size: 14px; color: var(--ink-3); }

  .hero-visual { position: relative; height: clamp(340px, 38vw, 500px); perspective: 1400px; }
  .hv-browser {
    position: absolute; inset: 0 10% auto 0;
    border-radius: 14px; overflow: hidden; background: #fff;
    box-shadow: 0 0 0 1px var(--line), var(--shadow-lg);
    transform: rotateY(-10deg) rotateX(4deg);
    transform-style: preserve-3d;
  }
  .hv-bar { display: flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; background: var(--bg-soft); border-bottom: 1px solid var(--line); }
  .hv-bar i { width: 8px; height: 8px; background: var(--line-strong); }
  .hv-bar i:first-child { background: var(--leaf); }
  .hv-bar i:nth-child(2) { background: var(--gem); }
  .hv-bar span { margin-left: auto; margin-right: auto; font-size: 11px; color: var(--ink-3); background: #fff; border: 1px solid var(--line); border-radius: 5px; padding: 1px 12px; }
  .hv-view { height: clamp(260px, 32vw, 400px); overflow: hidden; }
  .hv-view img { width: 100%; animation: hv-scroll 70s 3s ease-in-out infinite alternate; }
  @keyframes hv-scroll { to { transform: translateY(calc(-100% + clamp(260px, 32vw, 400px))); } }

  .hv-phone {
    position: absolute; right: 0; bottom: -6%;
    width: clamp(130px, 15vw, 190px);
    padding: 7px; border-radius: 30px; background: var(--ink);
    box-shadow: inset 0 0 0 2px #24474c, var(--shadow-lg);
    transform: rotate(4deg);
  }
  .hv-phone-screen { aspect-ratio: 9 / 19; border-radius: 23px; overflow: hidden; background: #fff; }
  .hv-phone-screen img { width: 100%; animation: hv-scroll-p 60s 4s ease-in-out infinite alternate; }
  @keyframes hv-scroll-p { to { transform: translateY(-62%); } }

  .hv-tag {
    position: absolute;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 14px;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 0 0 1px var(--line), var(--shadow);
    font-family: var(--font-pixel); font-size: 13px; letter-spacing: 0.04em; color: var(--marine);
    white-space: nowrap;
  }
  .hv-tag i { width: 8px; height: 8px; background: var(--leaf); }
  .hv-tag--a { left: -4%; bottom: 14%; }
  .hv-tag--b { right: 2%; top: -6%; background: var(--marine); color: #fff; box-shadow: var(--shadow); }

  .hero-world { height: clamp(220px, 34vh, 380px); z-index: 1; }

  .hero-scroll {
    position: absolute; left: 50%; bottom: 22px; z-index: 3;
    transform: translateX(-50%);
    display: none; align-items: center; gap: 10px;
    font-family: var(--font-pixel); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    color: #fff;
    padding: 8px 14px; border-radius: 6px; background: rgba(8, 42, 51, 0.5);
    backdrop-filter: blur(6px);
  }
  .hero-scroll svg { animation: nudge 1.4s steps(3) infinite; }
  @keyframes nudge { 50% { transform: translateY(3px); } }
  @media (min-width: 900px) { .hero-scroll { display: inline-flex; } }

  @media (max-width: 1099px) {
    .hero-visual { max-width: 640px; width: 100%; margin-inline: auto; }
  }
  @media (max-width: 640px) {
    .hero-stats { gap: 18px; flex-wrap: nowrap; }
    .hero-stats dt { font-size: 24px; }
    .hero-stats dd { font-size: 12.5px; line-height: 1.3; }
    .hero-visual { height: 330px; }
    .hv-browser { inset: 0 16% auto 0; transform: none; }
    .hv-view { height: 220px; }
    @keyframes hv-scroll { to { transform: translateY(calc(-100% + 220px)); } }
    .hv-tag--a { left: 0; bottom: 4%; }
    .hv-tag--b { top: -18px; right: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hv-view img, .hv-phone-screen img { animation: none; }
  }
</style>
