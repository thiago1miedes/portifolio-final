---
// Faixa infinita (CSS). Pausa ao passar o mouse; parada para quem prefere menos movimento.
interface Props { items: readonly string[] }
const { items } = Astro.props;
---
<div class="marquee" role="region" aria-label="Habilidades e ferramentas">
  <div class="marquee-track">
    {[0, 1].map((copy) => (
      <ul class="marquee-group" aria-hidden={copy === 1 ? "true" : undefined}>
        {items.map((t) => <li><span>{t}</span><i aria-hidden="true">✦</i></li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 4;
    overflow: hidden;
    background: var(--bg);
    border-block: 1px solid var(--border);
    padding-block: clamp(14px, 2vw, 22px);
  }
  .marquee-track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .marquee-group { display: flex; flex: none; }
  .marquee-group li {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 36px);
    padding-right: clamp(18px, 2.4vw, 36px);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.75rem);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .marquee-group i { font-style: normal; font-size: 0.55em; color: var(--accent); }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>
