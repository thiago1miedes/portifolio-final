---
// Borda de "grama" em pixel art para a transição entre seções claras e escuras.
interface Props { seed?: number; class?: string; to?: string }
const { seed = 3, class: cls = "", to = "var(--abyss)" } = Astro.props;

function rng(a: number) {
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(seed);
const P = 12, COLS = 160, ROWS = 6;
const cells: { x: number; y: number; c: string }[] = [];
for (let x = 0; x < COLS; x++) {
  const tuft = Math.floor(Math.sin(x * 0.35 + seed) * 1.2 + r() * 1.6) + 1; // 0..3
  // grama (verde claro) no topo, cada vez mais escuro para baixo
  for (let y = ROWS - 1; y >= ROWS - 3 - Math.max(0, tuft); y--) {
    const depth = ROWS - 1 - y;
    const top = y === ROWS - 3 - Math.max(0, tuft);
    let c = top ? "var(--leaf)" : depth > 1 ? "var(--forest)" : "var(--forest-2)";
    if (!top && r() < 0.08) c = "var(--leaf-2)";
    cells.push({ x, y, c });
  }
}
---
<div class:list={["pixel-edge", cls]} aria-hidden="true">
  <svg viewBox={`0 0 ${COLS * P} ${ROWS * P}`} preserveAspectRatio="xMidYMax slice" shape-rendering="crispEdges">
    {cells.map((s) => <rect x={s.x * P} y={s.y * P} width={P} height={P} fill={s.c} />)}
  </svg>
  <div class="pixel-edge-base" style={`background:${to}`}></div>
</div>

<style>
  .pixel-edge { position: relative; height: 72px; margin-bottom: -1px; }
  .pixel-edge svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pixel-edge-base { position: absolute; left: 0; right: 0; bottom: 0; height: 12px; }
  @media (max-width: 700px) { .pixel-edge { height: 48px; } }
</style>
