---
import Icon from "./Icon.astro";
import Sticker from "./Sticker.astro";
import { cases } from "../data/cases";
import { homeBoard } from "../data/site";
import { boardCapaOf } from "../data/capas";

const isPortrait = (ratio: string) => {
  const [w, h] = ratio.split("/").map(Number);
  return w < h;
};

const list = homeBoard.flatMap((b) => {
  const c = cases.find((x) => x.slug === b.slug);
  if (!c) return [];
  const portrait = isPortrait(b.ratio);
  const capa = boardCapaOf(b.slug, portrait);
  const src = capa?.src ?? b.image ?? c.thumb.src;
  // as imagens de marca têm versão de 800 px; capas novas e miniaturas já vêm no tamanho certo
  const srcset = !capa && b.image ? `${b.image.replace(".webp", "-w800.webp")} 800w, ${b.image} 1600w` : undefined;
  return [{ ...b, c, portrait, src, srcset }];
});
const kindOf = (c: (typeof cases)[number]) => (c.cats.includes("brand") ? "Identidade visual" : "Website");
---
<section class="section projects" id="projetos" data-board-section>
  <div class="board-mat" data-board-mat aria-hidden="true"></div>

  <div class="container">
    <header class="board-head">
      <div class="board-title">
        <h2 class="title-section" data-split>Meus <em>Projetos</em></h2>
        <svg class="board-scribble" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" data-draw>
          <path d="M4 13C42 4 86 18 138 9s106-6 158 2" />
        </svg>
      </div>

      <svg class="board-curve" viewBox="0 0 420 120" aria-hidden="true" data-bezier>
        <line class="curve-arm" data-arm="a" x1="20" y1="96" x2="130" y2="96" />
        <line class="curve-arm" data-arm="b" x1="400" y1="24" x2="290" y2="24" />
        <path class="curve-line" data-curve d="M20 96C130 96 290 24 400 24" />
        <rect class="curve-anchor" x="15" y="91" width="10" height="10" />
        <rect class="curve-anchor" x="395" y="19" width="10" height="10" />
        <circle class="curve-handle" data-handle="a" cx="130" cy="96" r="8" />
        <circle class="curve-handle" data-handle="b" cx="290" cy="24" r="8" />
      </svg>

      <div class="board-tools">
        <p class="board-hint">Arrasta, empilha, bagunça. Clicou, abriu.</p>
        <button type="button" class="btn btn--ghost btn--sm" data-shuffle><Icon name="shuffle" /> Embaralhar</button>
      </div>
    </header>

    <div class="board" data-board>
      <div class="board-prints">
        {list.map((b, i) => (
          <article
            class:list={["print", { "print--portrait": b.portrait }]}
            data-print
            style={`--x:${b.x}%;--y:${b.y}%;--w:${b.w}%;--r:${b.r}deg;--ratio:${b.ratio};--i:${i}`}
          >
            <div class="print-tilt">
            <div class="print-body" data-print-body>
              <a href={`/cases/${b.c.slug}/`} class="print-link" data-cursor="view" draggable="false">
                <div class="print-media">
                  <img src={b.src} srcset={b.srcset} sizes={b.srcset ? "(min-width: 900px) 34vw, 80vw" : undefined} alt={`Projeto ${b.c.title}`} loading="lazy" decoding="async" draggable="false" />
                </div>
                <div class="print-caption">
                  <div>
                    <h3 class="print-title">{b.c.title}</h3>
                    <p class="print-kind">{kindOf(b.c)} <span class="print-sector">· {b.c.sector.split(" · ")[0]}</span></p>
                  </div>
                  <Icon name="arrow-up-right" size={18} />
                </div>
              </a>
            </div>
            {b.deco === "pin"
              ? <span class="print-pin" aria-hidden="true"><Icon name="pushpin" size={34} /></span>
              : <span class:list={["print-tape", { "print-tape--accent": b.deco === "tape-accent" }]} aria-hidden="true"></span>}
            </div>
          </article>
        ))}
      </div>

      <Sticker name="spark" x="59.5%" y="3%" size="5.5%" r={14} msize="46px" mx="84%" my="10%" />
      <Sticker name="eyedropper" tone="ink" x="65.5%" y="48%" size="4.5%" r={-22} msize="42px" mx="4%" my="46%" />
      <Sticker name="smile" x="92%" y="50%" size="6%" r={10} msize="48px" mx="86%" my="62%" />
      <Sticker name="registration" x="0.5%" y="38%" size="3.6%" r={8} msize="34px" mx="2%" my="88%" />
      <Sticker name="swatch" x="69.5%" y="74%" size="7.5%" r={-7} msize="58px" mx="6%" my="22%" />
      <Sticker name="scissors" tone="ink" x="60%" y="30.5%" size="4.5%" r={24} msize="38px" mx="84%" my="36%" />
      <Sticker name="bolt" x="29.5%" y="68.5%" size="4.6%" r={-12} msize="40px" mx="80%" my="82%" />

      <a href="/cases/" class="board-badge" data-badge tabindex="-1" aria-hidden="true" data-cursor="view">
        <svg viewBox="0 0 160 160">
          <defs><path id="badge-circle" d="M80 80m-62 0a62 62 0 1 1 124 0a62 62 0 1 1-124 0" /></defs>
          <text><textPath href="#badge-circle" textLength="384">VER TODOS OS PROJETOS · VER TODOS OS PROJETOS · </textPath></text>
        </svg>
        <Icon name="arrow-up-right" size={30} />
      </a>

      <div class="board-ghost" data-ghost aria-hidden="true">
        <Icon name="cursor" size={26} />
        <span>Thiago</span>
      </div>
    </div>

    <div class="projects-all" data-reveal>
      <a href="/cases/" class="link-arrow">Ver todos os {cases.length} projetos <Icon name="arrow-up-right" /></a>
    </div>
  </div>
</section>

<style>
  /* isolate: os z-index altos das fotos e figurinhas valem só aqui dentro, abaixo do menu fixo */
  .projects { position: relative; overflow: clip; isolation: isolate; }

  /* a mesa: malha de tapete de corte, com uma luz que segue o mouse */
  .board-mat {
    --mx: 50%;
    --my: 30%;
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: 50% 0;
    mask-image: linear-gradient(transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(transparent, #000 12%, #000 88%, transparent);
  }
  .board-mat::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(520px circle at var(--mx) var(--my), rgba(255, 90, 31, 0.16), transparent 70%);
  }
  .projects > .container { position: relative; }

  .board-head { display: grid; gap: 20px; margin-bottom: clamp(36px, 5vw, 64px); }
  .board-title { position: relative; justify-self: start; }
  .board-scribble { position: absolute; right: -1%; bottom: -0.34em; width: 62%; height: 16px; overflow: visible; font-size: var(--fs-title); pointer-events: none; }
  .board-scribble path { fill: none; stroke: var(--accent); stroke-width: 5; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .board-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
  .board-hint { font-size: var(--fs-small); color: var(--text-muted); }
  .board-tools :global(.icon) { width: 18px; height: 18px; }
  @media (hover: none) { .board-hint { display: none; } }

  /* curva de Bézier que dá para puxar pelas alças */
  .board-curve { display: none; }
  .curve-line { fill: none; stroke: #f5f2ec; stroke-width: 2.5; stroke-linecap: round; }
  .curve-arm { stroke: var(--accent); stroke-width: 1.5; }
  .curve-anchor { fill: var(--bg); stroke: #f5f2ec; stroke-width: 2; }
  .curve-handle { fill: var(--accent); stroke: var(--bg); stroke-width: 2; cursor: grab; touch-action: none; transition: r 0.25s var(--ease); }
  .curve-handle:hover { r: 11; }
  .curve-handle:active { cursor: grabbing; }

  @media (min-width: 900px) {
    .board-head { grid-template-columns: auto minmax(0, 1fr) auto; align-items: end; gap: 32px; }
    .board-tools { flex-direction: column; align-items: flex-end; }
    .board-hint { text-align: right; }
  }
  @media (min-width: 1100px) and (hover: hover) and (pointer: fine) {
    .board-curve { display: block; width: 100%; max-width: 420px; justify-self: center; overflow: visible; }
  }

  /* celular: coluna em zigue-zague, com as fotos se sobrepondo um pouco */
  .board { position: relative; }
  .board-prints { display: flex; flex-direction: column; }
  /* três camadas: .print é arrastada (GSAP), .print-tilt inclina (CSS), .print-body acompanha o mouse e a rolagem (GSAP).
     O GSAP absorve a propriedade rotate do elemento que anima, por isso a inclinação fica numa camada só dela. */
  /* no celular cada foto fica por cima da seguinte: quem se esconde é o alto da próxima, nunca a legenda desta */
  .print { position: relative; width: 78%; z-index: calc(30 - var(--i)); will-change: transform; }
  .print-tilt { position: relative; rotate: var(--r); transition: rotate 0.55s var(--ease), scale 0.55s var(--ease); }
  .print--portrait { width: 56%; }
  .print + .print { margin-top: -7%; }
  .print:nth-child(even) { align-self: flex-end; }

  /* tablet: mais espaço de sobra, para o zigue-zague aparecer */
  @media (min-width: 700px) and (max-width: 899px) {
    .print { width: 60%; }
    .print--portrait { width: 42%; }
  }

  /* computador: cada foto no seu lugar da mesa */
  @media (min-width: 900px) {
    .board { aspect-ratio: 1 / 1; }
    .board-prints { display: contents; }
    .print, .print--portrait { position: absolute; left: var(--x); top: var(--y); width: var(--w); z-index: auto; }
    .print + .print { margin-top: 0; }
  }

  .print:hover .print-tilt, .print:focus-within .print-tilt, .print.is-dragging .print-tilt { rotate: calc(var(--r) * 0.2 + var(--swing, 0deg)); scale: 1.03; }
  .print.is-dragging .print-tilt { scale: 1.07; }

  .print-body {
    border-radius: 6px;
    background: #f5f2ec;
    color: #0a0a0b;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35), 0 22px 44px -14px rgba(0, 0, 0, 0.75);
    transition: box-shadow 0.45s var(--ease);
  }
  .print:hover .print-body, .print:focus-within .print-body { box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35), 0 36px 64px -14px rgba(0, 0, 0, 0.85); }
  .print.is-dragging .print-body { box-shadow: 0 8px 14px rgba(0, 0, 0, 0.3), 0 56px 90px -18px rgba(0, 0, 0, 0.9); }

  .print-link { display: block; padding: clamp(7px, 0.8vw, 11px) clamp(7px, 0.8vw, 11px) 0; user-select: none; -webkit-user-select: none; -webkit-user-drag: none; }
  .print-link:focus-visible { outline-color: var(--accent); }
  .print-media { position: relative; aspect-ratio: var(--ratio); overflow: hidden; border-radius: 2px; background: #dcd8d0; }
  .print-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; pointer-events: none; -webkit-user-drag: none; }
  .print-caption { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 3px 12px; }
  .print-caption > :global(.icon) { flex: none; width: 18px; height: 18px; color: #6a6a70; transition: transform 0.35s var(--ease), color 0.3s; }
  .print:hover .print-caption > :global(.icon) { transform: translate(2px, -2px); color: var(--accent); }
  .print-title { font-size: var(--fs-body); letter-spacing: -0.025em; line-height: 1.1; color: #0a0a0b; }
  .print-kind { margin-top: 3px; font-size: var(--fs-small); line-height: 1.25; color: #66666c; }

  /* fita adesiva com as pontas picotadas */
  /* nas fotos em pé a legenda quebraria com o · no começo da linha: fica só o tipo de trabalho */
  @media (max-width: 1199px) { .print--portrait .print-sector { display: none; } }

  .print-tape {
    position: absolute;
    left: 50%;
    top: -13px;
    width: clamp(70px, 8vw, 110px);
    height: 28px;
    translate: -50% 0;
    rotate: -3deg;
    background: rgba(245, 242, 236, 0.3);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    clip-path: polygon(0 0, 3% 12%, 0 25%, 3% 37%, 0 50%, 3% 62%, 0 75%, 3% 87%, 0 100%, 100% 100%, 97% 87%, 100% 75%, 97% 62%, 100% 50%, 97% 37%, 100% 25%, 97% 12%, 100% 0);
    pointer-events: none;
  }
  .print-tape--accent { background: rgba(255, 90, 31, 0.88); rotate: 4deg; }
  .print-pin { position: absolute; left: 50%; top: -18px; translate: -50% 0; rotate: 18deg; color: var(--accent); filter: drop-shadow(2px 6px 4px rgba(0, 0, 0, 0.5)); pointer-events: none; }
  .print-pin :global(.icon) { width: clamp(26px, 2.6vw, 34px); height: auto; }

  /* selo que gira e leva para todos os projetos */
  .board-badge { display: none; }
  @media (min-width: 900px) {
    .board-badge {
      position: absolute;
      left: 80%;
      top: 76%;
      z-index: 800;
      display: grid;
      place-items: center;
      width: 11.5%;
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--accent);
      color: var(--on-accent);
      box-shadow: 0 18px 36px -12px var(--accent-glow);
      transition: scale 0.5s var(--ease);
    }
    .board-badge:hover { scale: 1.08; }
    .board-badge svg:not(.icon) { position: absolute; inset: 0; width: 100%; height: 100%; }
    .board-badge text { font-family: var(--font-heading); font-weight: 700; font-size: 15px; fill: var(--on-accent); }
    .board-badge :global(.icon) { width: 28%; height: auto; }
  }

  /* o cursor que mostra, uma vez, que as fotos se arrastam */
  .board-ghost {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 950;
    display: none;
    pointer-events: none;
    opacity: 0;
  }
  .board-ghost :global(.icon) { color: var(--accent); filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.5)); }
  .board-ghost span {
    display: block;
    margin: -3px 0 0 18px;
    padding: 3px 9px;
    border-radius: 3px 10px 10px 10px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  @media (min-width: 900px) and (hover: hover) and (pointer: fine) { .board-ghost { display: block; } }

  .projects-all { display: flex; justify-content: center; margin-top: clamp(40px, 5vw, 72px); }
</style>
