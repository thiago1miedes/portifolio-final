---
import Icon from "./Icon.astro";
import { cases } from "../data/cases";
import { homeProjects } from "../data/site";

const list = homeProjects
  .map((slug) => cases.find((c) => c.slug === slug))
  .filter((c): c is (typeof cases)[number] => Boolean(c));
// a home mostra só dois tipos de trabalho: site ou identidade visual
const kindOf = (c: (typeof list)[number]) => (c.cats.includes("brand") ? "Identidade visual" : "Website");
---
<section class="section projects" id="projetos">
  <div class="container">
    <header class="section-head section-head--split">
      <div class="projects-heading">
        <h2 class="title-section" data-split>Meus <em>Projetos</em></h2>
      </div>
    </header>

    <div class="projects-grid">
      {list.map((c) => (
        <article class="project" data-project={c.slug} data-reveal>
          <a href={`/cases/${c.slug}/`} class="project-link" data-cursor="view">
            <div class="project-media">
              <img src={c.thumb.src} width={c.thumb.w} height={c.thumb.h} alt={`Projeto ${c.title}`} loading="lazy" decoding="async" data-project-img />
            </div>
            <div class="project-info">
              <div>
                <h3 class="project-title">{c.title}</h3>
                <p class="project-cat">{kindOf(c)} · {c.sector}</p>
              </div>
              <span class="project-more">Ver projeto <Icon name="arrow-up-right" /></span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="projects-all" data-reveal>
      <a href="/cases/" class="link-arrow">Ver todos os {cases.length} projetos <Icon name="arrow-up-right" /></a>
    </div>
  </div>
</section>

<style>
  .projects-heading { display: grid; gap: 18px; }
  .projects-grid {
    display: grid;
    gap: clamp(36px, 4vw, 56px) clamp(16px, 2.4vw, 32px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .project-link { display: flex; flex-direction: column; gap: 18px; height: 100%; }
  /* 3:2 é o formato das capas (1200×800): a imagem aparece inteira, sem cortes */
  .project-media {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    isolation: isolate;
  }
  /* sobra de 6% para o parallax não mostrar borda */
  .project-media img {
    position: absolute;
    left: 0; top: -3%;
    width: 100%;
    height: 106%;
    object-fit: cover;
    object-position: center top;
    transition: scale 0.9s var(--ease);
  }
  .project-link:hover .project-media img,
  .project-link:focus-visible .project-media img { scale: 1.04; }


  .project-info { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .project-title { font-size: clamp(1.25rem, 1.8vw, 1.625rem); letter-spacing: -0.03em; transition: color 0.3s; }
  .project-cat { margin-top: 4px; font-size: 0.875rem; color: var(--text-muted); }
  .project-more {
    flex: none;
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: 4px;
    font-size: 0.875rem; font-weight: 600;
    color: var(--text-muted);
    transition: color 0.3s;
  }
  .project-more :global(.icon) { width: 16px; height: 16px; transition: transform 0.35s var(--ease); }
  .project-link:hover .project-title { color: var(--accent); }
  .project-link:hover .project-more { color: var(--text); }
  .project-link:hover .project-more :global(.icon) { transform: translate(2px, -2px); color: var(--accent); }
  @media (max-width: 479px) { .project-more { display: none; } }

  .projects-all { display: flex; justify-content: center; margin-top: clamp(48px, 6vw, 88px); }
</style>
