---
import CaseCard from "./CaseCard.astro";
import { cases, categories, countBy, type Category } from "../data/cases";
const cats = (Object.keys(categories) as Category[]).filter((k) => countBy(k) > 0);
---
<div class="projects" data-projects>
  <div class="filters" role="toolbar" aria-label="Filtrar projetos">
    <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">Todos <sup>{cases.length}</sup></button>
    {cats.map((k) => (
      <button type="button" class="filter" data-filter={k} aria-pressed="false">
        {categories[k]} <sup>{countBy(k)}</sup>
      </button>
    ))}
  </div>
  <div class="grid" data-grid>
    {cases.map((c) => <CaseCard c={c} />)}
  </div>
</div>

<style>
  .filters {
    display: flex; gap: 8px; flex-wrap: nowrap; overflow-x: auto;
    padding-block: 4px 6px; margin-bottom: clamp(28px, 4vw, 48px);
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter);
  }
  .filters::-webkit-scrollbar { display: none; }
  @media (min-width: 900px) { .filters { flex-wrap: wrap; overflow: visible; margin-inline: 0; padding-inline: 0; } }
  .filter {
    flex: none;
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 44px; padding: 0 18px;
    border-radius: var(--radius-pill);
    background: var(--surface-glass);
    border: 1px solid var(--border);
    font-family: var(--font-heading); font-weight: 600; font-size: 0.9375rem; color: var(--text-muted);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .filter sup { font-size: 0.6875rem; color: var(--text-muted); top: -0.5em; }
  .filter:hover { border-color: var(--border-strong); color: var(--text); }
  .filter.is-active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .filter.is-active sup { color: var(--on-accent); }
  .grid {
    display: grid;
    gap: clamp(32px, 3.4vw, 48px) clamp(16px, 2vw, 28px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1040px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
