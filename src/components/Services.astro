---
import PixelIcon from "./PixelIcon.astro";
import { countBy } from "../data/cases";
import { tools } from "../data/site";

const services = [
  { icon: "web", title: "Web design", text: "Sites institucionais, landing pages e e-commerces desenhados no Figma, com foco em clareza, conversão e uma navegação gostosa no celular.", tags: ["UI design", "Landing pages", "Protótipos"], count: countBy("web") },
  { icon: "dev", title: "Desenvolvimento front-end", text: "Do layout ao código: HTML, CSS e JavaScript leves, animações com GSAP, responsividade de verdade, SEO e formulários que viram contato.", tags: ["HTML/CSS/JS", "GSAP", "WordPress"], count: countBy("dev") },
  { icon: "brand", title: "Identidade visual", text: "Logotipo, paleta, tipografia e manual de marca, sempre apresentados em contexto para você enxergar a marca funcionando no dia a dia.", tags: ["Logotipo", "Manual de marca", "Rebranding"], count: countBy("brand") },
  { icon: "social", title: "Social media", text: "Posts, carrosséis, stories e capas de destaque com identidade consistente e campanhas pensadas para vender.", tags: ["Feed", "Stories", "Campanhas"], count: countBy("social") },
  { icon: "print", title: "Papelaria & impressos", text: "Cartões, receituários, pastas, folders e sacolas prontos para a gráfica, com arquivos técnicos organizados.", tags: ["Papelaria", "Folders", "Arquivos técnicos"], count: countBy("print") },
  { icon: "deck", title: "Apresentações & embalagens", text: "Decks comerciais, media kits, e-books e rótulos que ajudam a vender um projeto, um patrocínio ou um produto.", tags: ["Decks", "Media kits", "Rótulos"], count: countBy("deck") + countBy("packaging") },
] as const;
---
<section class="section section--soft services" id="servicos">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <span class="eyebrow" data-reveal>O que eu faço</span>
        <h2 class="h-section" data-split style="margin-top:18px">Design de ponta a ponta, <span class="hl">com foco em web.</span></h2>
      </div>
      <p class="lead" data-reveal>Posso cuidar de uma etapa ou do projeto inteiro: a marca, o site, o conteúdo e o código que coloca tudo no ar.</p>
    </div>

    <div class="svc-grid">
      {services.map((s, i) => (
        <article class:list={["svc", { "svc--main": i < 2 }]} data-reveal="up">
          <div class="svc-top">
            <span class="svc-icon"><PixelIcon name={s.icon} size={44} /></span>
            <span class="svc-count">{String(s.count).padStart(2, "0")} projetos</span>
          </div>
          <h3 class="svc-title">{s.title}</h3>
          <p class="svc-text">{s.text}</p>
          <ul class="svc-tags">{s.tags.map((t) => <li class="chip">{t}</li>)}</ul>
        </article>
      ))}
    </div>

    <div class="tools" data-reveal>
      <span class="tools-label">Ferramentas do dia a dia</span>
      <ul class="tools-list">
        {tools.map((t) => <li><i aria-hidden="true"></i>{t}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .svc-grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .svc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .svc-grid { grid-template-columns: repeat(12, 1fr); } .svc { grid-column: span 3; } .svc--main { grid-column: span 6; } }
  .svc {
    position: relative;
    display: flex; flex-direction: column; gap: 14px;
    padding: clamp(22px, 2.4vw, 32px);
    background: #fff;
    border-radius: 22px;
    box-shadow: 0 0 0 1px var(--line);
    transition: box-shadow 0.4s var(--ease), transform 0.5s var(--ease);
    overflow: hidden;
  }
  .svc::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 6px;
    background: repeating-linear-gradient(90deg, var(--leaf) 0 12px, var(--forest) 12px 24px, var(--sea) 24px 36px, var(--marine) 36px 48px);
    transform: scaleX(0); transform-origin: left; transition: transform 0.6s var(--ease);
  }
  .svc:hover { box-shadow: 0 0 0 1px var(--line-strong), var(--shadow); transform: translateY(-4px); }
  .svc:hover::after { transform: scaleX(1); }
  .svc--main { background: linear-gradient(160deg, #fff 40%, var(--mint-2)); }
  .svc-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px; }
  .svc-icon { display: grid; place-items: center; width: 72px; height: 72px; border-radius: 16px; background: var(--bg-soft); box-shadow: inset 0 0 0 1px var(--line); }
  .svc:hover .svc-icon :global(.px-icon) { animation: px-hop 0.6s steps(3) 1; }
  @keyframes px-hop { 50% { transform: translateY(-4px); } }
  .svc-count { font-family: var(--font-pixel); font-size: 13px; color: var(--forest); letter-spacing: 0.04em; }
  .svc-title { font-size: clamp(1.4rem, 2vw, 1.8rem); letter-spacing: -0.03em; }
  .svc--main .svc-title { font-size: clamp(1.6rem, 2.6vw, 2.3rem); }
  .svc-text { color: var(--ink-2); font-size: 16px; }
  .svc-tags { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 6px; padding-top: 10px; }

  .tools {
    margin-top: clamp(24px, 3vw, 40px);
    display: grid; gap: 18px;
    padding: 24px; border-radius: 22px; background: #fff; box-shadow: 0 0 0 1px var(--line);
  }
  @media (min-width: 900px) { .tools { grid-template-columns: 220px 1fr; align-items: center; } }
  .tools-label { font-family: var(--font-pixel); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--marine); }
  .tools-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .tools-list li {
    display: inline-flex; align-items: center; gap: 8px;
    height: 38px; padding: 0 14px; border-radius: 8px;
    background: var(--bg-soft); font-weight: 500; font-size: 15px; color: var(--ink);
    transition: background-color 0.3s;
  }
  .tools-list li:hover { background: var(--mint); }
  .tools-list li i { width: 6px; height: 6px; background: var(--forest); }
  .tools-list li:nth-child(even) i { background: var(--sea); }
</style>
