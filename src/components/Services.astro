---
// Lista discreta, toda fechada: quem quer saber abre. Usa o mesmo acordeão do FAQ (data-faq em main.ts).
import Icon from "./Icon.astro";
import { services } from "../data/site";
---
<section class="services" id="servicos">
  <div class="container services-grid">
    <h2 class="services-title" data-reveal>O que eu posso <em>criar</em></h2>

    <div class="services-list" data-faq data-reveal>
      {services.map((s, i) => (
        <div class="service" data-faq-item>
          <h3 class="service-heading">
            <button
              type="button"
              class="service-trigger"
              id={`service-trigger-${i}`}
              aria-expanded="false"
              aria-controls={`service-panel-${i}`}
              data-faq-index={i}
            >
              <span class="service-name">{s.title}</span>
              <span class="service-icon" aria-hidden="true"><Icon name="plus" size={18} /></span>
            </button>
          </h3>
          <div class="service-panel is-hidden" id={`service-panel-${i}`} role="region" aria-labelledby={`service-trigger-${i}`}>
            <div class="service-body">
              <p>{s.text}</p>
              <p class="service-tags">{s.tags.join(", ")}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services { padding-block: clamp(48px, 6vw, 88px); }
  .services-grid { display: grid; gap: 20px; align-items: start; }
  @media (min-width: 900px) { .services-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 48px; } }
  .services-title { font-size: clamp(1.5rem, 2.6vw, 2.25rem); letter-spacing: -0.035em; }

  .services-list { border-top: 1px solid var(--border); }
  .service { border-bottom: 1px solid var(--border); }
  .service-heading { font-size: inherit; letter-spacing: normal; }
  .service-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    min-height: 48px;
    padding-block: 12px;
    text-align: left;
    color: var(--text-muted);
    transition: color 0.25s;
  }
  .service-trigger:hover, .service.is-open .service-trigger { color: var(--text); }
  .service-name { font-family: var(--font-heading); font-weight: 500; font-size: 1.0625rem; letter-spacing: -0.015em; }
  .service-icon { flex: none; display: grid; transition: transform 0.4s var(--ease), color 0.25s; }
  /* + vira × */
  .service.is-open .service-icon { transform: rotate(45deg); color: var(--accent); }

  .service-panel { overflow: hidden; }
  .service-body { display: grid; gap: 8px; max-width: 62ch; padding-bottom: 18px; font-size: 0.9375rem; line-height: 1.55; color: var(--text-muted); }
  .service-tags { font-size: 0.8125rem; color: var(--text-muted); opacity: 0.75; }
</style>
