---
import Icon from "./Icon.astro";
import { services, tools } from "../data/site";
---
<section class="section services" id="servicos">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow" data-reveal>O que eu faço</p>
      <h2 class="title-section services-title" data-split>O que eu posso <em>criar</em> pra você...</h2>
    </header>

    <div class="services-grid">
      <aside class="tools-card" data-reveal>
        <h3 class="tools-title">Ferramentas que eu uso</h3>
        <p class="muted">Do rascunho ao arquivo final, com as ferramentas certas para cada etapa do projeto.</p>
        <ul class="tools">
          {tools.map((t) => (
            <li class="tool">
              <span class="tool-icon"><Icon name={t.icon} size={34} /></span>
              <span class="tool-name">{t.name}</span>
            </li>
          ))}
        </ul>
        <p class="status"><i></i>Agenda aberta para novos projetos</p>
      </aside>

      <div class="services-list" data-services>
        {services.map((s, i) => (
          <article class:list={["service", { "is-active": i === 0 }]} data-service data-reveal>
            <h3 class="service-heading">
              <button
                type="button"
                class="service-trigger"
                id={`service-trigger-${i}`}
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`service-panel-${i}`}
                data-service-index={i}
              >
                <span class="service-icon"><Icon name={s.icon} /></span>
                <span class="service-name">{s.title}</span>
                <span class="service-toggle" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
              </button>
            </h3>
            <div
              class:list={["service-panel", { "is-hidden": i !== 0 }]}
              id={`service-panel-${i}`}
              role="region"
              aria-labelledby={`service-trigger-${i}`}
              data-service-panel
            >
              <div class="service-body">
                <p>{s.text}</p>
                <ul class="service-tags">{s.tags.map((t) => <li>{t}</li>)}</ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .services-title { max-width: 14ch; }
  .services-grid { display: grid; gap: 20px; align-items: start; }
  @media (min-width: 1000px) {
    .services-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 4vw, 64px); }
    .tools-card { position: sticky; top: 110px; }
  }

  /* ferramentas */
  .tools-card {
    display: grid;
    gap: 18px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-card);
    background: var(--surface-glass);
    border: 1px solid var(--border);
  }
  .tools-title { font-size: clamp(1.375rem, 2vw, 1.75rem); letter-spacing: -0.03em; }
  .tools { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 6px; }
  .tool { display: grid; justify-items: center; gap: 10px; text-align: center; }
  .tool-icon {
    display: grid; place-items: center;
    width: 100%;
    aspect-ratio: 1;
    max-width: 88px;
    border-radius: 20px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    transition: background-color 0.3s, color 0.3s, transform 0.4s var(--ease), border-color 0.3s;
  }
  .tool:hover .tool-icon { background: var(--accent); border-color: var(--accent); color: var(--on-accent); transform: translateY(-4px) rotate(-4deg); }
  .tool-name { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.3; }
  .tools-card .status { padding-top: 18px; border-top: 1px solid var(--border); }

  /* acordeão de serviços */
  .services-list { display: grid; gap: 10px; }
  .service {
    border-radius: var(--radius-card);
    background: var(--surface-glass);
    border: 1px solid var(--border);
    color: var(--text);
    transition: background-color 0.45s var(--ease), color 0.45s var(--ease), border-color 0.45s;
  }
  .service:hover { border-color: var(--border-strong); }
  .service.is-active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .service-heading { font-size: inherit; letter-spacing: normal; }
  .service-trigger {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: clamp(16px, 2vw, 22px) clamp(16px, 2.4vw, 28px);
    text-align: left;
    border-radius: var(--radius-card);
  }
  .service-icon {
    flex: none;
    display: grid; place-items: center;
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--surface-glass-2);
    transition: background-color 0.45s;
  }
  .service.is-active .service-icon { background: rgba(10, 10, 11, 0.12); }
  .service-name {
    flex: 1;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .service-toggle {
    flex: none;
    display: grid; place-items: center;
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1px solid currentColor;
    opacity: 0.7;
    transition: transform 0.5s var(--ease), opacity 0.3s;
  }
  .service-trigger:hover .service-toggle { opacity: 1; }
  .service.is-active .service-toggle { transform: rotate(90deg); opacity: 1; }
  .service-trigger:focus-visible { outline-offset: -4px; }
  .service.is-active .service-trigger:focus-visible { outline-color: var(--on-accent); }

  .service-panel { overflow: hidden; }
  .service-body {
    display: grid;
    gap: 18px;
    padding: 0 clamp(16px, 2.4vw, 28px) clamp(20px, 2.4vw, 28px);
  }
  @media (min-width: 640px) { .service-body { padding-left: calc(clamp(16px, 2.4vw, 28px) + 64px); } }
  .service-body p { font-size: 1.0625rem; line-height: 1.55; max-width: 52ch; }
  .service-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .service-tags li {
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(10, 10, 11, 0.3);
    background: rgba(10, 10, 11, 0.06);
    font-size: 0.8125rem;
    font-weight: 600;
  }
</style>
