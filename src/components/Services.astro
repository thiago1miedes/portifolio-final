---
// Cards dos serviços, com figurinhas em volta que representam cada um. Textos e figurinhas em site.ts.
import Sticker from "./Sticker.astro";
import { services } from "../data/site";
---
<section class="section services" id="servicos">
  <div class="container">
    <header class="section-head">
      <h2 class="title-section" data-split>O que eu posso <em>criar</em></h2>
    </header>

    <!-- o reveal fica na grade: em cada card, a figurinha arrastada passaria por baixo do card seguinte -->
    <div class="services-grid" data-reveal>
      {services.map((s) => (
        <article class="service-card">
          <h3 class="title-card">{s.title}</h3>
          <p class="service-text">{s.text}</p>
          <ul class="service-tags">{s.tags.map((t) => <li class="chip">{t}</li>)}</ul>
          {s.stickers.map((k) => <Sticker {...k} />)}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* clip: as figurinhas da última coluna podem passar da borda da tela sem criar rolagem de lado */
  .services { isolation: isolate; overflow-x: clip; }
  .services-grid { display: grid; gap: clamp(24px, 2.4vw, 32px); }
  @media (min-width: 700px) { .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .services-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 2.4vw, 32px);
    border-radius: 20px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    transition: background-color 0.3s, border-color 0.3s;
  }
  .service-card:hover { background: var(--bg-elev-2); border-color: var(--border-strong); }
  .service-card:hover :global(.sticker svg) { rotate: -8deg; }
  .service-text { color: var(--text-muted); }
  .service-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 6px; }
</style>
