---
// Título e texto no centro, aplicativos espalhados em volta. Os ícones saem de trás do texto ao entrar na tela,
// flutuam, respondem ao mouse e dá para arrastar (src/scripts/playground.ts). Posições em site.ts.
import Icon from "./Icon.astro";
import { tools } from "../data/site";
---
<section class="tools" id="ferramentas">
  <div class="container">
    <div class="tools-stage" data-tools>
      <div class="tools-text">
        <h2 class="title-section" data-split>Minhas <em>ferramentas</em></h2>
        <p data-reveal>Ferramentas que eu utilizo no meu dia a dia para o desenvolvimento de projetos.</p>
      </div>

      <ul class="tools-cloud">
        {tools.map((t, i) => (
          <li
            class="tool"
            data-tool
            data-size={t.size}
            style={`--x:${t.x}%;--y:${t.y}%;--mx:${t.mx}%;--my:${t.my}%;--size:${t.size}px;--r:${t.r}deg;--bob:${4 + (i % 4) * 0.8}s;--bob-delay:-${i * 0.7}s`}
          >
            <div class="tool-float" data-tool-float>
              <div class="tool-tilt">
                <span class:list={["tool-tile", { "tool-tile--box": t.tile }]}>
                  <Icon name={t.icon} size={64} />
                </span>
              </div>
            </div>
            <span class="tool-name">{t.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .tools { position: relative; isolation: isolate; overflow-x: clip; padding-block: clamp(48px, 6vw, 88px); }

  .tools-stage {
    --k: 0.62;
    position: relative;
    display: grid;
    place-items: center;
    min-height: 520px;
  }
  .tools-text { position: relative; display: grid; gap: 16px; max-width: 62%; text-align: center; }
  .tools-text p { color: var(--text-muted); }
  .tools-cloud { position: absolute; inset: 0; pointer-events: none; }

  .tool {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    width: calc(var(--size) * var(--k));
    aspect-ratio: 1;
    pointer-events: auto;
    user-select: none;
    -webkit-user-select: none;
  }
  .tool:hover, .tool.is-tapped { z-index: 5; }

  /* três camadas: .tool é arrastada e .tool-float acompanha o mouse (GSAP); .tool-tilt inclina e flutua (CSS) */
  .tool-tilt {
    rotate: var(--r);
    animation: tool-bob var(--bob) ease-in-out var(--bob-delay) infinite alternate;
    transition: rotate 0.4s var(--ease), scale 0.4s var(--ease);
  }
  .tool:hover .tool-tilt, .tool.is-tapped .tool-tilt { rotate: 0deg; scale: 1.14; }
  @keyframes tool-bob { from { translate: 0 -5px; } to { translate: 0 5px; } }

  .tool-tile { display: block; filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.55)); }
  .tool-tile :global(svg) { width: 100%; height: auto; aspect-ratio: 1; }
  /* quem não tem quadrado próprio no ícone (Figma, VS Code, Blender) ganha um */
  .tool-tile--box { padding: 19%; border-radius: 22%; background: #1f1f24; box-shadow: inset 0 0 0 1px var(--border); }

  .tool-name {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 12px);
    translate: -50% 4px;
    padding: 4px 10px;
    border-radius: 8px;
    background: #f5f2ec;
    color: #0a0a0b;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-small);
    letter-spacing: -0.01em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, translate 0.3s var(--ease);
  }
  .tool:hover .tool-name, .tool.is-tapped .tool-name { opacity: 1; translate: -50% 0; }

  /* telas bem estreitas: o título precisa caber entre os ícones das laterais */
  @media (max-width: 359px) { .tools-text :global(h2) { font-size: 2.125rem; } }

  @media (min-width: 700px) {
    .tools-stage { --k: 0.8; min-height: clamp(460px, 42vw, 560px); }
    .tools-text { max-width: 56%; }
    .tool { left: var(--x); top: var(--y); }
  }
  @media (min-width: 1100px) { .tools-stage { --k: 1; } }
</style>
