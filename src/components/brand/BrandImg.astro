---
// Imagem de cases/<slug>/IMAGENS.md. Enquanto o arquivo não existe em public/<assets>/img/, mostra um
// placeholder neutro com o id (opcionais só aparecem no dev). Basta salvar o .webp/.avif com o id certo.
import { imageInfo, imageVisible, type BrandCaseData } from "../../data/brand-cases";

interface Props {
  data: BrandCaseData;
  id: string;
  class?: string;
  sizes?: string;
  eager?: boolean;
  decorative?: boolean;
  [attr: `data-${string}`]: unknown;
}
const { data, id, class: cls, sizes = "100vw", eager = false, decorative = false, ...attrs } = Astro.props;
const info = imageInfo(data, id);
---
{info.exists ? (
  <picture class:list={["bc-img", cls]} {...attrs}>
    {info.avif && <source type="image/avif" srcset={info.avifSet ?? info.avif} sizes={sizes} />}
    {info.webp && <source type="image/webp" srcset={info.webpSet ?? info.webp} sizes={sizes} />}
    <img
      src={info.webp ?? info.avif}
      width={info.w}
      height={info.h}
      alt={decorative ? "" : info.alt}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  </picture>
) : imageVisible(info) && (
  <div
    class:list={["bc-ph", cls]}
    role={decorative ? undefined : "img"}
    aria-label={decorative ? undefined : `Imagem pendente: ${info.alt}`}
    aria-hidden={decorative ? "true" : undefined}
    style={`aspect-ratio:${info.w}/${info.h}`}
    data-image-id={id}
    {...attrs}
  >
    <span class="bc-ph-id">{id}</span>
    <span class="bc-ph-meta">{info.w}×{info.h} · {info.essential ? "essencial" : "opcional"}</span>
  </div>
)}
