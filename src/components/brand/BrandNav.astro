---
import BrandLogo from "./BrandLogo.astro";
import type { BrandCaseData } from "../../data/brand-cases";

interface Props { data: BrandCaseData; sections: { id: string; label: string }[] }
const { data, sections } = Astro.props;
// logos só de lettering mostram o logotipo inteiro no desktop e o monograma no celular (logo.nav no case.json)
const nav = data.logo.nav ?? {};
const desktop = nav.desktop ?? ["symbol", "wordmark"];
const mobile = nav.mobile ?? ["symbol"];
const arts = [...new Set([...desktop, ...mobile])];
---
<header class="bc-nav" data-bc-nav data-theme="dark" style={nav.wordmarkHeight ? `--nav-wordmark-h:${nav.wordmarkHeight}px` : undefined}>
  <a href="#intro" class="bc-nav-logo" aria-label={`${data.client} — voltar ao topo do case`}>
    {arts.map((art) => (
      <BrandLogo
        data={data}
        art={art}
        decorative
        class:list={[`bc-nav-${art}`, { "is-desktop-only": !mobile.includes(art), "is-mobile-only": !desktop.includes(art) }]}
      />
    ))}
  </a>
  <nav class="bc-nav-links" aria-label="Seções do case" data-bc-nav-links>
    {sections.map((s) => <a href={`#${s.id}`} class="bc-nav-link" data-section-link={s.id}>{s.label}</a>)}
  </nav>
  <a href="/" class="bc-nav-exit" aria-label="Thiago Miedes — voltar para a home do portfólio">
    <img class="bc-nav-avatar" src="/about/avatar.webp" width="80" height="80" alt="" />
    <span class="bc-nav-exit-label">Thiago</span>
  </a>
  <span class="bc-nav-progress" aria-hidden="true"><i data-bc-progress></i></span>
</header>
