---
// Tela de app feita em código (sem IA): celular com uma interface nas cores da marca (textos em screen, no case.json).
import BrandLogo from "./BrandLogo.astro";
import BrandText from "./BrandText.astro";
import { plain, type AppItem, type BrandCaseData } from "../../data/brand-cases";

interface Props { data: BrandCaseData; item: AppItem }
const { data, item } = Astro.props;
const screen = item.screen!;
const head = item.head ?? ["symbol", "wordmark"];
---
<figure class="bc-app">
  <div class="bc-app-stage">
    <div class="bc-phone" data-speed="3">
      <div class="bc-phone-screen" role="img" aria-label={plain(screen.alt) || `Tela de app com a marca ${data.client}`}>
        <div class="bc-app-status" aria-hidden="true"><span>9:41</span><span class="bc-app-dots"><i></i><i></i><i></i></span></div>
        <div class="bc-app-head" aria-hidden="true">
          {head.map((art) => <BrandLogo data={data} art={art} variant={item.variant} decorative class={`bc-app-${art}`} />)}
        </div>
        <p class="bc-app-greet" aria-hidden="true">{screen.greeting}</p>
        {screen.cards.map((card, i) => (
          <div class:list={["bc-app-card", { "is-primary": i === 0 }]} aria-hidden="true">
            <small>{card.label}</small>
            <strong>{card.title}</strong>
            <span>{card.meta}</span>
          </div>
        ))}
        <div class="bc-app-progress" aria-hidden="true">
          <small>{screen.progress.label}</small>
          <span class="bc-app-bar"><i style={`width:${screen.progress.value}%`}></i></span>
          <b>{screen.progress.value}%</b>
        </div>
        <div class="bc-app-tabbar" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      </div>
    </div>
  </div>
  {item.caption && <figcaption><BrandText text={item.caption} /></figcaption>}
</figure>
