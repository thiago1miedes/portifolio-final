---
// 7. Aplicações: colagem com fotos editoriais P&B, recortes gigantes do logotipo, faixa em movimento,
//    grafismo do símbolo e mockups. Tudo que é geométrico sai do próprio SVG; só as fotos vêm da IA.
import BrandImg from "./BrandImg.astro";
import BrandLogo from "./BrandLogo.astro";
import BrandText from "./BrandText.astro";
import CaseMockup from "./CaseMockup.astro";
import CaseApp from "./CaseApp.astro";
import CaseFeed from "./CaseFeed.astro";
import { assetUrl, imageInfo, imageVisible, plain, readSvg, variantVars, type AppItem, type BrandCaseData } from "../../data/brand-cases";

interface Props { data: BrandCaseData }
const { data } = Astro.props;
const a = data.applications;
const items = a.items.filter((it) => !it.image || imageVisible(imageInfo(data, it.image)));
const symbol = readSvg(data, "symbol");
const [sx, sy, sw, sh] = symbol.viewBox;
// o símbolo pode estar fora da origem (ex.: o monograma recortado do meio do logotipo); o padrão o traz para o canto do módulo
const tile = (dx: number, dy: number) => `translate(${+(dx - sx * 0.5).toFixed(2)} ${+(dy - sy * 0.5).toFixed(2)}) scale(0.5)`;
const patternId = `bc-pattern-${data.slug}`;
const vars = (v?: string) => Object.entries(variantVars(data, v)).map(([k, val]) => `${k}:${val}`).join(";");
const cell = (it: AppItem) => `--c0:${it.col[0]};--cs:${it.col[1]};--ms:${it.mobile};--off:${it.offset ?? 0}`;
const ratio = (it: AppItem) => {
  const info = imageInfo(data, it.image!);
  return `--ar:${info.w}/${info.h}`;
};
const loops = Array.from({ length: 4 });
const marqueeArts = a.marqueeArts ?? ["wordmark", "symbol"];
const slides = (it: AppItem) => (it.slides ?? []).filter((s) => imageVisible(imageInfo(data, s.image)));

// mosaic: formas no módulo de 100 × 100, sorteadas com semente fixa (a mesma em toda build)
const SHAPES: Record<string, string> = {
  block: '<rect width="100" height="100"/>',
  corner: '<path d="M0 0H100V100H50A50 50 0 0 1 0 50Z"/>',
  quarter: '<path d="M0 0H100A100 100 0 0 1 0 100Z"/>',
  half: '<path d="M0 100A50 50 0 0 1 100 100Z"/>',
  leaf: '<path d="M0 100V50A50 50 0 0 1 50 0H100V50A50 50 0 0 1 50 100Z"/>',
  circle: '<circle cx="50" cy="50" r="38"/>',
  ring: '<path fill-rule="evenodd" d="M50 12a38 38 0 1 0 0 76a38 38 0 1 0 0-76ZM50 34a16 16 0 1 1 0 32a16 16 0 1 1 0-32Z"/>',
  frame: '<path fill-rule="evenodd" d="M0 0H100V100H0ZM33 33V67H67V33Z"/>',
  dots: '<circle cx="50" cy="22" r="9"/><circle cx="50" cy="50" r="9"/><circle cx="50" cy="78" r="9"/>',
};
const t = data.theme;
const PAIRS: [string, string][] = [
  [t.primary, t.accent], [t.accent, t.primary], [t.primary, t.support], [t.support, t.primary],
  [t.accent, t.support], [t.support, t.accent], [t.dark, t.accent], [t.primary, t.light],
];
function mosaic(it: AppItem) {
  let seed = [...`${data.slug}:${it.col.join(",")}`].reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) >>> 0, 7);
  const rand = () => { // mulberry32
    seed = (seed + 0x6d2b79f5) >>> 0;
    let x = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
    return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
  };
  const pick = <T,>(list: T[]) => list[Math.floor(rand() * list.length)];
  const [cols, rows] = it.grid ?? [4, 4];
  const names = Object.keys(SHAPES);
  const cells = Array.from({ length: cols * rows }, (_, i) => {
    const [bg, fg] = pick(PAIRS);
    return {
      x: (i % cols) * 100, y: Math.floor(i / cols) * 100, bg, fg, shape: SHAPES[pick(names)],
      angle: Math.floor(rand() * 4) * 90, turn: rand() < 0.5 ? -1 : 1, phase: +rand().toFixed(3),
    };
  });
  return { cols, rows, cells, clip: `bc-mosaic-${data.slug}-${it.col.join("-")}` };
}
---
<section class="bc-apps" id="aplicacoes" data-theme="light" data-bc-section>
  <div class="container bc-section-head bc-section-head--split">
    <div>
      <BrandText as="h2" class="bc-h2" text={a.title} data-bc-split />
    </div>
    <BrandText as="p" class="bc-body" text={a.text} data-bc-reveal />
  </div>

  <div class="container bc-collage">
    {items.map((it) => (
      <div class="bc-cell" data-kind={it.kind} style={cell(it)}>
        {it.kind === "photo" && (
          <figure data-bc-reveal>
            <div class="bc-photo" style={ratio(it)}>
              <BrandImg data={data} id={it.image!} sizes="(min-width: 900px) 45vw, 100vw" data-speed={it.speed ?? 4} />
            </div>
            {it.caption && <figcaption><BrandText text={it.caption} /></figcaption>}
          </figure>
        )}

        {it.kind === "cutout" && (
          <figure data-bc-reveal>
            <div class="bc-cutout" style={ratio(it)} data-speed={it.speed ?? 3}>
              {it.tilt
                ? <BrandImg data={data} id={it.image!} sizes={it.col[1] > 6 ? "(min-width: 900px) 70vw, 100vw" : "(min-width: 900px) 40vw, 100vw"} data-bc-tilt />
                : <BrandImg data={data} id={it.image!} sizes="(min-width: 900px) 40vw, 100vw" />}
            </div>
            {it.caption && <figcaption><BrandText text={it.caption} /></figcaption>}
          </figure>
        )}

        {it.kind === "track" && (
          <div class="bc-track" data-bc-track>
            <ul class="bc-track-row" role="list" data-bc-track-row>
              {slides(it).map((s, i) => (
                <li class="bc-track-item" data-index={i}>
                  <figure>
                    <div class="bc-cutout" style={`--ar:${imageInfo(data, s.image).w}/${imageInfo(data, s.image).h}`}>
                      <BrandImg data={data} id={s.image} sizes="(min-width: 900px) 30vw, 76vw" data-bc-tilt />
                    </div>
                    {s.caption && <figcaption><BrandText text={s.caption} /></figcaption>}
                  </figure>
                </li>
              ))}
            </ul>
            {it.hint && <p class="bc-track-hint" aria-hidden="true"><span>{it.hint}</span><i></i></p>}
          </div>
        )}

        {it.kind === "mosaic" && (() => {
          const m = mosaic(it);
          return (
            <figure data-bc-reveal>
              <div class="bc-mosaic" style={`--ar:${m.cols}/${m.rows}`}>
                <svg class="bc-mosaic-svg" viewBox={`0 0 ${m.cols * 100} ${m.rows * 100}`} xmlns="http://www.w3.org/2000/svg" aria-hidden="true" data-bc-mosaic>
                  <defs><clipPath id={m.clip}><rect width="100" height="100" /></clipPath></defs>
                  {m.cells.map((c, i) => (
                    <g transform={`translate(${c.x} ${c.y})`}>
                      {/* o fundo passa meio ponto da célula: sem frestas de antisserrilhado entre vizinhas */}
                      <rect x="-0.5" y="-0.5" width="101" height="101" fill={c.bg} />
                      <g clip-path={`url(#${m.clip})`}>
                        <g data-bc-mosaic-shape data-index={i} data-turn={c.turn} data-phase={c.phase}>
                          <g transform={`rotate(${c.angle} 50 50)`} fill={c.fg}>
                            <rect width="100" height="100" fill="none" />
                            <Fragment set:html={c.shape} />
                          </g>
                        </g>
                      </g>
                    </g>
                  ))}
                </svg>
              </div>
              {it.caption && <figcaption><BrandText text={it.caption} /></figcaption>}
            </figure>
          );
        })()}

        {it.kind === "heading" && (
          <div class="bc-group" data-bc-reveal>
            <BrandText as="h3" class="bc-group-title" text={it.caption} />
            {it.text && <BrandText as="p" class="bc-group-text" text={it.text} />}
          </div>
        )}

        {it.kind === "piece" && (
          <figure data-bc-reveal>
            {it.frame === "phone" ? (
              <div class="bc-piece-phone" data-speed={it.speed ?? 3}>
                <div class="bc-phone bc-phone--media">
                  <div class="bc-phone-screen bc-phone-media"><BrandImg data={data} id={it.image!} sizes="(min-width: 900px) 280px, 45vw" /></div>
                </div>
              </div>
            ) : (
              <div class="bc-piece" style={ratio(it)} data-speed={it.speed ?? 3}>
                <BrandImg data={data} id={it.image!} sizes={it.col[1] > 6 ? "(min-width: 900px) 60vw, 100vw" : "(min-width: 900px) 34vw, 50vw"} />
              </div>
            )}
            {it.caption && <figcaption><BrandText text={it.caption} /></figcaption>}
          </figure>
        )}

        {it.kind === "feed" && <CaseFeed data={data} item={it} />}

        {it.kind === "graphic" && (
          <figure data-bc-reveal>
            <div class="bc-graphic" style={`--ar:${it.w}/${it.h}`} data-speed={it.speed ?? 2}>
              <img src={assetUrl(data, it.src!)} width={it.w} height={it.h} alt={plain(it.alt)} loading="lazy" decoding="async" />
            </div>
            {it.caption && <figcaption><BrandText text={it.caption} /></figcaption>}
          </figure>
        )}

        {it.kind === "crop" && (
          <div class="bc-crop" style={vars(it.variant)} data-bc-reveal>
            <BrandLogo data={data} art={it.art ?? "wordmark"} viewBox={it.viewBox} preserve="xMidYMid slice" variant={it.variant} decorative data-bc-crop />
          </div>
        )}

        {it.kind === "mockup" && <CaseMockup data={data} item={it} />}

        {it.kind === "app" && <CaseApp data={data} item={it} />}

        {it.kind === "marquee" && (
          <div class="bc-marquee" aria-hidden="true" data-bc-marquee>
            <div class="bc-marquee-row" data-marquee-dir="-1">
              {loops.map(() => (
                <span class="bc-marquee-item">
                  {marqueeArts.map((art) => <BrandLogo data={data} art={art} variant="positive" decorative />)}
                </span>
              ))}
            </div>
            <div class="bc-marquee-row is-outline" data-marquee-dir="1">
              {loops.map(() => (
                <span class="bc-marquee-item">
                  {marqueeArts.map((art) => <BrandLogo data={data} art={art} decorative />)}
                </span>
              ))}
            </div>
          </div>
        )}

        {it.kind === "pattern" && (
          <div class="bc-pattern" style={`--logo-bg:${data.theme.dark};--logo-symbol-main:${data.theme.primary};--logo-symbol-accent:${data.theme.secondary}`} data-bc-reveal>
            <svg class="bc-logo bc-pattern-svg" viewBox="0 0 800 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <pattern id={patternId} width={sw * 1.2} height={sh * 1.1} patternUnits="userSpaceOnUse">
                  <g transform={tile(sw * 0.05, sh * 0.025)} set:html={symbol.inner} />
                  <g transform={tile(sw * 0.65, sh * 0.575)} set:html={symbol.inner} />
                </pattern>
              </defs>
              <rect x="0" y={-sh * 1.1} width="800" height={800 + sh * 2.2} fill={`url(#${patternId})`} data-bc-pattern data-shift={sh * 1.1} />
            </svg>
            <BrandLogo data={data} art="symbol" variant="negative" decorative class="bc-pattern-mark" />
          </div>
        )}
      </div>
    ))}
  </div>
</section>
