---
// 2b. Grafismo (opcional): pictogramas em grade e, abaixo, os padrões numa faixa que corre com a rolagem.
//     Os arquivos vêm prontos do vetor (graphics.items[].src em public/<assets>/), nada passa pela IA.
import BrandText from "./BrandText.astro";
import { assetUrl, plain, type BrandCaseData } from "../../data/brand-cases";

interface Props { data: BrandCaseData }
const { data } = Astro.props;
const g = data.graphics!;
---
<section class="bc-graphics" id="grafismo" data-theme="dark" data-bc-section data-bc-graphics>
  <div class="container bc-section-head bc-section-head--split">
    <div>
      <BrandText as="h2" class="bc-h2" text={g.title} data-bc-split />
    </div>
    <BrandText as="p" class="bc-body" text={g.text} data-bc-reveal />
  </div>

  <ul class="container bc-pictos">
    {g.items.map((it, i) => (
      <li class="bc-picto" data-index={i} data-bc-picto>
        <span class="bc-picto-art">
          <img src={assetUrl(data, it.src)} width="240" height="240" alt={plain(it.alt)} loading="lazy" decoding="async" />
        </span>
        <BrandText class="bc-picto-label" text={it.label} />
      </li>
    ))}
  </ul>

  {g.patterns && (
    <figure class="bc-patterns">
      <div class="bc-patterns-track" data-bc-patterns-track>
        <div class="bc-patterns-row" data-bc-patterns-row>
          {g.patterns.map((p) => (
            <img class="bc-pattern-tile" src={assetUrl(data, p.src)} width={p.w} height={p.h} alt={plain(p.alt)} loading="lazy" decoding="async" />
          ))}
        </div>
      </div>
      {g.patternsNote && <figcaption class="container"><BrandText text={g.patternsNote} /></figcaption>}
    </figure>
  )}
</section>
