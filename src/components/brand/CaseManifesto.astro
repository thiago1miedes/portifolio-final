---
// 4. Virada do escuro para o claro: manifesto em headline grande e quatro atributos separados por linhas finas.
import BrandText from "./BrandText.astro";
import type { BrandCaseData } from "../../data/brand-cases";

interface Props { data: BrandCaseData }
const { data } = Astro.props;
const m = data.manifesto;
---
<section class="bc-manifesto" id="manifesto" data-theme="light" data-bc-section data-bc-turn>
  <div class="container">
    <BrandText as="p" class="bc-manifesto-headline" text={m.headline} data-bc-scrub-words />
    <ol class="bc-attrs">
      {m.attributes.map((a, i) => (
        <li class="bc-attr" data-index={i} data-bc-attr>
          <span class="bc-attr-line" aria-hidden="true"></span>
          <h3 class="bc-attr-word">{a.word}</h3>
          <BrandText as="p" class="bc-attr-text" text={a.text} />
        </li>
      ))}
    </ol>
  </div>
</section>
