---
// 2. Símbolo grande ao lado do conceito; ao rolar, as peças se separam e ganham legenda.
//    Com symbol.crop, um quadrado recorta o símbolo: dentro fica o módulo do grafismo, fora só o contorno.
//    Com symbol.grid, as linhas da grade de construção se desenham atrás do símbolo.
//    Com symbol.carve, o símbolo começa maciço: o traço do vazio se desenha e o volume se abre até a forma real.
import BrandLogo from "./BrandLogo.astro";
import BrandImg from "./BrandImg.astro";
import BrandText from "./BrandText.astro";
import { readSvg, readSvgFile, variantVars, type BrandCaseData } from "../../data/brand-cases";

interface Props { data: BrandCaseData }
const { data } = Astro.props;
const s = data.symbol;
const symbol = readSvg(data, "symbol");
const [sx, sy, w, h] = symbol.viewBox;
const crop = s.crop;
const clipId = `bc-crop-${data.slug}`;
const variant = s.variant ?? "onPrimary";
const vars = Object.entries(variantVars(data, variant)).map(([k, v]) => `${k}:${v}`).join(";");
// as linhas passam um pouco das bordas do símbolo, como numa prancha de construção (menos à direita, onde ficam as legendas)
const ext = Math.max(w, h) * 0.08;
const gridLines = s.grid
  ? [
      ...s.grid.x.map((x) => ({ x1: x, y1: sy - ext, x2: x, y2: sy + h + ext })),
      ...s.grid.y.map((y) => ({ x1: sx - ext, y1: y, x2: sx + w + ext * 0.3, y2: y })),
    ]
  : [];
const carve = s.carve && { solid: readSvgFile(data, s.carve.solid), void: readSvgFile(data, s.carve.void) };
const drawnLabel = [symbol.label, gridLines.length && "sobre a grade de construção"].filter(Boolean).join(", ");
---
<section class="bc-symbol" id="simbolo" data-theme="dark" data-bc-section data-bc-symbol>
  <div class="bc-sticky">
    {s.image && <div class="bc-bg bc-symbol-bg"><BrandImg data={data} id={s.image} decorative /></div>}
    <div class="container bc-symbol-grid">
      <div class="bc-symbol-art">
        <div class="bc-symbol-stage" style={`aspect-ratio:${w}/${h};--sym-ratio:${(w / h).toFixed(4)}`}>
          {crop ? (
            <svg
              class="bc-logo bc-symbol-svg bc-crop-svg"
              xmlns="http://www.w3.org/2000/svg"
              viewBox={symbol.viewBox.join(" ")}
              style={vars}
              role="img"
              aria-label={`${symbol.label}, recortado por um quadrado que vira o módulo do grafismo`}
            >
              <defs>
                <clipPath id={clipId}><rect x={crop[0]} y={crop[1]} width={crop[2]} height={crop[3]} /></clipPath>
              </defs>
              <g data-bc-crop-full set:html={symbol.inner} />
              <g class="bc-crop-outline" data-bc-crop-outline aria-hidden="true" set:html={readSvg(data, "outline").inner} />
              <g clip-path={`url(#${clipId})`} aria-hidden="true" set:html={symbol.inner} />
              <rect class="bc-crop-frame" data-bc-crop-frame x={crop[0]} y={crop[1]} width={crop[2]} height={crop[3]} pathLength="1" />
            </svg>
          ) : gridLines.length || carve ? (
            <svg
              class="bc-logo bc-symbol-svg"
              xmlns="http://www.w3.org/2000/svg"
              viewBox={symbol.viewBox.join(" ")}
              style={vars}
              role="img"
              aria-label={drawnLabel}
            >
              {gridLines.length > 0 && (
                <g class="bc-symbol-lines" aria-hidden="true">
                  {gridLines.map((l, i) => <line {...l} pathLength="1" data-bc-grid-line data-index={i} />)}
                </g>
              )}
              <g set:html={symbol.inner} />
              {carve && <g class="bc-carve-solid" aria-hidden="true" data-bc-carve-solid set:html={carve.solid.inner} />}
              {carve && <g class="bc-carve-void" aria-hidden="true" data-bc-carve-void set:html={carve.void.inner} />}
            </svg>
          ) : (
            <BrandLogo data={data} art="symbol" variant={variant} class="bc-symbol-svg" />
          )}
          {s.pieces.map((p, i) => (
            <p class="bc-piece-label" data-piece-label={p.piece} data-shift={p.shift} data-index={i} style={`--y0:${p.y};--y1:${+(p.y + (p.shift / h) * 100).toFixed(2)}`}>
              <b>{p.label}</b>
              <BrandText text={p.text} />
            </p>
          ))}
        </div>
      </div>
      <div class="bc-symbol-text">
        <BrandText as="h2" class="bc-h2" text={s.title} data-bc-split />
        {s.text.map((t) => <BrandText as="p" class="bc-body" text={t} data-bc-reveal />)}
      </div>
    </div>
  </div>
</section>
