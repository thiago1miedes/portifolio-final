---
// 3. Tipografia: uma letra gigante da fonte da marca troca de forma (letra e peso) conforme a rolagem.
import BrandText from "./BrandText.astro";
import { readSvgFile, type BrandCaseData } from "../../data/brand-cases";

interface Props { data: BrandCaseData }
const { data } = Astro.props;
const t = data.typography;
const weightNames: Record<number, string> = {
  100: "Thin", 200: "ExtraLight", 300: "Light", 400: "Regular", 500: "Medium",
  600: "SemiBold", 700: "Bold", 800: "ExtraBold", 900: "Black",
};
const names = t.weights.map((w) => `${weightNames[w] ?? "Peso"} ${w}`);
const start = t.weights.includes(700) ? 700 : t.weights[t.weights.length - 1];
// glyphArts: letras em SVG (fonte sem arquivo de web); todas no quadro de 170 × 170, com a linha de base em y=150 e a altura das maiúsculas em y=46
const arts = (t.glyphArts ?? []).map((g) => ({ ...g, svg: readSvgFile(data, g.src) }));
const nameArt = t.nameArt ? readSvgFile(data, t.nameArt) : undefined;
const specimen = t.specimen ? readSvgFile(data, t.specimen.src) : undefined;
---
<section
  class="bc-type"
  id="tipografia"
  data-theme="dark"
  data-bc-section
  data-bc-type
  data-glyphs={t.glyphs.join(",")}
  data-weights={t.weights.join(",")}
  data-weight-names={names.join(",")}
  style={t.font === "text" ? "--bc-type-font:var(--bc-font-text, var(--bc-font))" : undefined}
>
  <div class="bc-sticky">
    <div class="container bc-type-grid">
      <div class="bc-type-track" data-bc-type-track>
      <div class="bc-type-stage" data-bc-type-stage>
        <div class="bc-type-glyph-wrap" data-bc-glyph-wrap>
          <span class="bc-type-guide is-cap is-hidden" data-bc-guide="cap" aria-hidden="true"><i>altura das maiúsculas</i></span>
          <span class="bc-type-guide is-base is-hidden" data-bc-guide="base" aria-hidden="true"><i>linha de base</i></span>
          {arts.length ? (
            <span class="bc-type-glyph bc-type-glyph--art" data-bc-glyph data-art-cap={46 / 170} data-art-base={150 / 170} aria-hidden="true">
              {arts.map((g, i) => (
                <svg class:list={["bc-type-art", { "is-hidden": i > 0 }]} xmlns="http://www.w3.org/2000/svg" viewBox={g.svg.viewBox.join(" ")} data-bc-glyph-art data-index={i} data-name={g.name} data-note={g.note} focusable="false" set:html={g.svg.inner} />
              ))}
            </span>
          ) : (
            <span class="bc-type-glyph" data-bc-glyph style={`font-weight:${start}`} aria-hidden="true">{t.glyphs[0]}</span>
          )}
        </div>
        <p class="bc-type-readout" aria-hidden="true">
          <span data-bc-glyph-name>{arts[0]?.name ?? t.glyphs[0]}</span> · <span data-bc-weight-name>{arts[0]?.note ?? names[t.weights.indexOf(start)]}</span>
        </p>
        {t.weights.length > 1 && (
          <ol class="bc-type-scale" aria-hidden="true">
            {t.weights.map((w) => <li data-weight={w} class:list={{ "is-active": w === start }}></li>)}
          </ol>
        )}
      </div>
      </div>

      <div class="bc-type-info">
        {nameArt ? (
          <h2 class="bc-type-name bc-type-name--art" aria-label={t.title}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox={nameArt.viewBox.join(" ")} aria-hidden="true" focusable="false" set:html={nameArt.inner} />
          </h2>
        ) : (
          <h2 class="bc-type-name">{t.title}</h2>
        )}
        <BrandText as="p" class="bc-body" text={t.text} />
        {specimen && (
          <svg class="bc-type-specimen" xmlns="http://www.w3.org/2000/svg" viewBox={specimen.viewBox.join(" ")} preserveAspectRatio="xMinYMid meet" role="img" aria-label={t.specimen!.alt} focusable="false" set:html={specimen.inner} />
        )}
        {t.second && (
          <div class="bc-type-second">
            <h3 class="bc-type-second-name">{t.second.name}</h3>
            <p class="bc-type-weights" aria-label={`Pesos da ${t.second.name}: ${t.second.weights.join(", ")}`}>
              {t.second.weights.map((w) => <span style={`font-weight:${w}`} aria-hidden="true">Aa</span>)}
            </p>
            <p class="bc-type-sample">{t.second.sample}</p>
          </div>
        )}
        <dl class="bc-spec">
          {t.spec.map((row) => <div><dt>{row.k}</dt><dd>{row.v}</dd></div>)}
        </dl>
        {!specimen && (
          <p class="bc-type-weights" aria-label={`Pesos da ${t.title}: ${t.weights.join(", ")}`}>
            {t.weights.map((w) => <span style={`font-weight:${w}`} aria-hidden="true">Aa</span>)}
          </p>
        )}
        {!specimen && <p class="bc-type-sample">{t.sample}</p>}
      </div>
    </div>
  </div>
</section>
