---
// Um carrossel no formato de post do Instagram: arrasta (ou setas), contador, bolinhas e zoom no lightbox.
// O comportamento fica em src/scripts/main.ts (data-carousel), no elemento que envolve este post e a sequência.
import Icon from "../Icon.astro";
import type { AssetItem } from "../../data/cases";

interface Props { group: string; title: string; profile: string; place: string; avatar: string; items: AssetItem[] }
const { group, title, profile, place, avatar, items } = Astro.props;
const n = items.length;
---
<figure class="ig">
  <header class="ig-head">
    <span class="ig-avatar"><img src={avatar} width="40" height="40" alt="" loading="lazy" /></span>
    <span class="ig-id"><b>{profile}</b><small>{place}</small></span>
    <span class="ig-more" aria-hidden="true"><Icon name="more" size={20} /></span>
  </header>

  <div class="ig-media">
    <ol class="ig-track" data-car-track data-lenis-prevent-horizontal tabindex="0" aria-label={`${title}: ${n} telas. Use as setas do teclado para navegar.`}>
      {items.map((it, k) => (
        <li class="ig-slide" aria-label={`Tela ${k + 1} de ${n}`}>
          <button
            type="button" class="ig-zoom" data-cursor="view"
            data-lightbox={it.video ?? it.src} data-poster={it.video ? it.src : undefined} data-lb-group={group}
            data-w={it.w} data-h={it.h} aria-label={`Ampliar tela ${k + 1}${it.label ? ` (${it.label})` : ""}`}
          >
            {it.video ? (
              <video width={it.w} height={it.h} poster={it.src} muted loop playsinline preload="none" data-car-video>
                <source src={it.video} type="video/mp4" />
              </video>
            ) : (
              <img src={it.src} width={it.w} height={it.h} alt={`${title} — tela ${k + 1}`} loading="lazy" decoding="async" />
            )}
          </button>
          {it.video && <span class="ig-badge"><Icon name="play" size={12} />Vídeo</span>}
        </li>
      ))}
    </ol>
    <span class="ig-count" data-car-count aria-hidden="true">{`1/${n}`}</span>
    <button type="button" class="ig-nav ig-prev is-hidden" data-car-prev aria-label="Tela anterior"><Icon name="chevron-left" size={20} /></button>
    <button type="button" class:list={["ig-nav ig-next", { "is-hidden": n < 2 }]} data-car-next aria-label="Próxima tela"><Icon name="chevron-right" size={20} /></button>
  </div>

  <footer class="ig-foot" aria-hidden="true">
    <span class="ig-actions"><Icon name="heart" size={22} /><Icon name="comment" size={22} /><Icon name="send" size={22} /></span>
    <span class="ig-dots">{items.map((_, k) => <i class:list={{ "is-active": k === 0 }} data-car-dot></i>)}</span>
    <span class="ig-save"><Icon name="bookmark" size={22} /></span>
  </footer>
  <figcaption class="ig-cap"><b>{profile}</b> {title}</figcaption>
</figure>

<style>
  .ig {
    margin: 0; width: 100%; max-width: 460px;
    border-radius: 22px; overflow: hidden;
    background: var(--bg-elev); border: 1px solid var(--border);
    box-shadow: 0 50px 90px -50px rgba(0, 0, 0, 0.9);
  }
  .ig-head { display: flex; align-items: center; gap: 12px; padding: 12px 14px; }
  .ig-avatar { flex: none; width: 40px; height: 40px; padding: 2px; border-radius: 50%; background: var(--accent); }
  .ig-avatar img { width: 100%; height: 100%; border-radius: 50%; border: 2px solid var(--bg-elev); background: var(--bg-elev); }
  .ig-id { display: grid; line-height: 1.25; font-size: 0.875rem; }
  .ig-id small { font-size: 0.75rem; color: var(--text-muted); }
  .ig-more { margin-left: auto; color: var(--text-muted); }

  .ig-media { position: relative; background: #000; }
  .ig-track {
    display: flex; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  .ig-track::-webkit-scrollbar { display: none; }
  .ig-track:focus-visible { outline-offset: -3px; border-radius: 0; }
  .ig-slide { position: relative; flex: 0 0 100%; aspect-ratio: 4 / 5; scroll-snap-align: start; scroll-snap-stop: always; }
  .ig-zoom { display: block; width: 100%; height: 100%; cursor: zoom-in; }
  .ig-zoom img, .ig-zoom video { width: 100%; height: 100%; object-fit: cover; }
  .ig-badge {
    position: absolute; left: 12px; bottom: 12px;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px 5px 8px; border-radius: var(--radius-pill);
    background: rgba(10, 10, 11, 0.72); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    font-size: 0.75rem; font-weight: 500; pointer-events: none;
  }
  .ig-badge :global(.icon) { color: var(--accent); fill: currentColor; }
  .ig-count {
    position: absolute; top: 12px; right: 12px;
    padding: 3px 9px; border-radius: var(--radius-pill);
    background: rgba(10, 10, 11, 0.72); font-size: 0.75rem; font-weight: 500; font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .ig-nav {
    position: absolute; top: 50%; translate: 0 -50%;
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.9); color: var(--on-accent);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    transition: background-color 0.25s, color 0.25s, scale 0.3s var(--ease);
  }
  .ig-nav:hover { background: var(--accent); scale: 1.08; }
  .ig-prev { left: 12px; }
  .ig-next { right: 12px; }

  .ig-foot { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 12px 14px 6px; }
  .ig-actions { display: flex; gap: 14px; }
  .ig-save { justify-self: end; }
  .ig-dots { display: flex; gap: 4px; }
  .ig-dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--border-strong); transition: background-color 0.25s, scale 0.25s; }
  .ig-dots i.is-active { background: var(--accent); scale: 1.15; }
  .ig-cap { padding: 4px 14px 16px; font-size: 0.875rem; color: var(--text-muted); }
  .ig-cap b { color: var(--text); font-weight: 600; margin-right: 4px; }
</style>
