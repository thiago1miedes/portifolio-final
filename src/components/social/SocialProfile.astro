---
// Perfil de Instagram montado com as peças do case (c.social.page): cabeçalho, capas de destaque e a grade do feed.
// Cada post da grade abre o lightbox no grupo "perfil", que percorre todas as telas de todos os posts
// (as telas depois da capa ficam em botões ocultos). Os posts além de `visible` aparecem com data-feed-more (main.ts).
import Icon from "../Icon.astro";
import type { Case } from "../../data/cases";

interface Props { c: Case }
const { c } = Astro.props;
const s = c.social!;
const p = s.page!;
const avatar = c.items.find((it) => it.id === (s.avatar ?? "logo"))!;
const groupOf = (key: string) => c.items.filter((it) => it.group === key);
const posts = p.feed.map((key) => {
  const items = groupOf(key);
  return { key, items, title: s.carousels.find((k) => k.key === key)?.title ?? items[0].label ?? c.title };
});
const highlights = groupOf("destaques");
const stories = c.items.filter((it) => it.kind === "story" && it.group !== "destaques").length;
const counts = [
  { n: posts.length, label: "posts" },
  { n: stories, label: "stories" },
  { n: highlights.length, label: "destaques" },
].filter((k) => k.n > 0);
---
<section class="sp" aria-labelledby="sp-t">
  <div class="container sp-grid-wrap">
    <header class="sp-head">
      <p class="eyebrow" data-reveal>O perfil</p>
      <h2 class="title-section" id="sp-t" data-split set:html={p.title} />
      <p class="lead" data-reveal>{p.note}</p>
    </header>

    <div class="sp-app" data-reveal>
      <div class="sp-top">
        <span class="sp-avatar"><img src={avatar.src} width={avatar.w} height={avatar.h} alt={`Logo ${c.title}`} loading="lazy" /></span>
        <div class="sp-info">
          <p class="sp-row">
            <b class="sp-handle">{s.profile}</b>
            <span class="sp-btns" aria-hidden="true"><span class="sp-btn sp-btn--main">Seguir</span><span class="sp-btn">Mensagem</span></span>
          </p>
          <ul class="sp-counts">
            {counts.map((k) => <li><b>{k.n}</b> {k.label}</li>)}
          </ul>
          <div class="sp-bio">
            <p class="sp-name">{p.name}</p>
            <p class="sp-cat">{p.category}</p>
            {p.bio.map((line) => <p>{line}</p>)}
            {c.live && <a href={c.live} target="_blank" rel="noopener" class="sp-link"><Icon name="link" size={14} />{p.link}</a>}
          </div>
        </div>
      </div>

      {highlights.length > 0 && <ul class="sp-highlights" aria-label="Capas de destaque">
        {highlights.map((h) => (
          <li>
            <button type="button" class="sp-hl" data-lightbox={h.src} data-lb-group="destaques" data-w={h.w} data-h={h.h} aria-label={`Ampliar a capa do destaque ${h.label}`}>
              <span class="sp-ring"><span class="sp-ring-in"><img src={h.src} width={h.w} height={h.h} alt="" loading="lazy" decoding="async" /></span></span>
              <span class="sp-hl-label">{h.label}</span>
            </button>
          </li>
        ))}
      </ul>}

      <div class="sp-tabs" aria-hidden="true">
        <span class="is-active"><Icon name="grid" size={14} />Posts</span>
        <span><Icon name="reels" size={14} />Reels</span>
        <span><Icon name="tagged" size={14} />Marcados</span>
      </div>

      <ol class="sp-feed" style={`--sp-ratio:${posts[0].items[0].w} / ${posts[0].items[0].h}`} aria-label={`Feed de @${s.profile}`}>
        {posts.map((post, k) => (
          <li class:list={{ "is-hidden": k >= p.visible }} data-feed-extra={k >= p.visible ? "" : undefined}>
            {post.items.map((it, i) => (
              <button
                type="button" class:list={["sp-post", { "is-hidden": i > 0 }]} data-cursor={i === 0 ? "view" : undefined}
                data-lightbox={it.src} data-lb-group="perfil" data-w={it.w} data-h={it.h}
                aria-label={`Ampliar o post ${post.title}${post.items.length > 1 ? ` (tela ${i + 1} de ${post.items.length})` : ""}`}
              >
                {i === 0 && <img src={it.src} width={it.w} height={it.h} alt={`${post.title} — post de ${c.title}`} loading="lazy" decoding="async" />}
                {i === 0 && post.items.length > 1 && <span class="sp-multi"><Icon name="multi" size={18} /></span>}
                {i === 0 && <span class="sp-hover"><b>{post.title}</b>{post.items.length > 1 && <small>{`${post.items.length} telas`}</small>}</span>}
              </button>
            ))}
          </li>
        ))}
      </ol>

      {posts.length > p.visible && (
        <button type="button" class="sp-more" data-feed-more>
          Ver o feed inteiro <span>{`${posts.length} posts`}</span>
        </button>
      )}
    </div>
  </div>
</section>

<style>
  .sp { padding-block: clamp(64px, 8vw, 120px); }
  .sp-grid-wrap { display: grid; gap: clamp(32px, 5vw, 56px); align-items: start; }
  @media (min-width: 1100px) {
    .sp-grid-wrap { grid-template-columns: minmax(0, 1fr) minmax(0, 640px); gap: clamp(48px, 7vw, 112px); }
    .sp-head { position: sticky; top: 120px; }
  }
  .sp-head { display: grid; gap: 20px; max-width: 520px; }

  /* o app: cabeçalho do perfil, destaques, abas e grade */
  .sp-app {
    width: 100%; max-width: 640px; justify-self: center;
    border-radius: var(--radius-lg); overflow: hidden;
    background: var(--bg-elev); border: 1px solid var(--border);
    box-shadow: 0 60px 110px -60px rgba(0, 0, 0, 0.95);
  }
  .sp-top { display: grid; grid-template-columns: auto 1fr; gap: clamp(16px, 4vw, 40px); align-items: start; padding: clamp(18px, 4vw, 36px) clamp(16px, 4vw, 36px) 8px; }
  .sp-avatar { display: block; width: clamp(76px, 18vw, 132px); aspect-ratio: 1; padding: 3px; border-radius: 50%; background: var(--accent); }
  .sp-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 3px solid var(--bg-elev); background: #000; }
  .sp-info { display: grid; gap: 14px; min-width: 0; }
  .sp-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .sp-handle { font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em; }
  .sp-btns { display: flex; gap: 6px; }
  .sp-btn { display: inline-flex; align-items: center; height: 30px; padding: 0 14px; border-radius: 8px; background: var(--surface-glass-2); font-size: 0.8125rem; font-weight: 600; }
  .sp-btn--main { background: var(--accent); color: var(--on-accent); }
  .sp-counts { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 0.875rem; color: var(--text-muted); }
  .sp-counts b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }
  .sp-bio { display: grid; gap: 2px; font-size: 0.875rem; line-height: 1.45; }
  .sp-name { font-weight: 600; }
  .sp-cat { color: var(--text-muted); }
  .sp-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 2px; color: var(--accent); font-weight: 500; }
  .sp-link:hover { text-decoration: underline; }
  @media (max-width: 520px) {
    .sp-top { grid-template-columns: auto 1fr; }
    .sp-bio { grid-column: 1 / -1; }
  }

  /* destaques: a capa 9:16 é recortada no círculo, ampliada no ícone central */
  .sp-highlights { display: flex; gap: clamp(12px, 3vw, 28px); overflow-x: auto; scrollbar-width: none; padding: 20px clamp(16px, 4vw, 36px) 22px; }
  .sp-highlights::-webkit-scrollbar { display: none; }
  .sp-hl { display: grid; justify-items: center; gap: 8px; width: clamp(64px, 14vw, 84px); cursor: zoom-in; }
  .sp-ring { display: block; width: 100%; aspect-ratio: 1; padding: 3px; border-radius: 50%; border: 1px solid var(--border-strong); background: var(--bg-elev); }
  .sp-ring-in { display: block; width: 100%; height: 100%; border-radius: 50%; overflow: hidden; }
  .sp-ring-in img { width: 100%; height: 100%; object-fit: cover; scale: 1.75; transition: scale 0.5s var(--ease); }
  .sp-hl:hover .sp-ring { border-color: var(--accent); }
  .sp-hl:hover .sp-ring-in img { scale: 1.9; }
  .sp-hl-label { max-width: 100%; text-align: center; font-size: 0.75rem; line-height: 1.25; color: var(--text-muted); }
  .sp-hl:hover .sp-hl-label { color: var(--text); }

  .sp-tabs { display: flex; justify-content: center; gap: clamp(24px, 8vw, 56px); border-top: 1px solid var(--border); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .sp-tabs span { display: inline-flex; align-items: center; gap: 6px; padding: 14px 0; margin-top: -1px; border-top: 1px solid transparent; }
  .sp-tabs .is-active { color: var(--text); border-top-color: var(--text); }

  /* grade 3:4, como o perfil do Instagram */
  .sp-feed { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; }
  .sp-post { position: relative; display: block; width: 100%; aspect-ratio: var(--sp-ratio, 3 / 4); overflow: hidden; background: #000; cursor: zoom-in; }
  .sp-post img { width: 100%; height: 100%; object-fit: cover; transition: scale 0.6s var(--ease); }
  .sp-post:hover img { scale: 1.04; }
  .sp-multi { position: absolute; top: 8px; right: 8px; color: #fff; filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.6)); display: inline-flex; }
  .sp-hover {
    position: absolute; inset: 0; display: grid; align-content: end; gap: 2px; padding: 12px;
    background: linear-gradient(to top, rgba(10, 10, 11, 0.88), rgba(10, 10, 11, 0) 60%);
    text-align: left; font-size: 0.8125rem; line-height: 1.3; opacity: 0; transition: opacity 0.3s;
  }
  .sp-hover small { color: var(--accent); font-size: 0.75rem; }
  .sp-post:hover .sp-hover, .sp-post:focus-visible .sp-hover { opacity: 1; }
  @media (hover: none) { .sp-hover { display: none; } }

  .sp-more {
    display: flex; justify-content: center; align-items: baseline; gap: 8px; width: 100%;
    padding: 18px; border-top: 1px solid var(--border);
    font-weight: 600; font-size: 0.9375rem; transition: background-color 0.25s, color 0.25s;
  }
  .sp-more span { font-weight: 400; font-size: 0.8125rem; color: var(--text-muted); }
  .sp-more:hover { background: var(--surface-glass); color: var(--accent); }
</style>
