---
// Corpo dos cases de social media (c.social): números, linguagem dos posts, índice e um bloco por carrossel,
// agrupados por frente de conteúdo. As telas são os itens de assets.json com group = chave do carrossel.
// Opcionais: abertura (intro), perfil simulado (page), stories da mesma campanha (group `${key}-st`),
// faixa de stories avulsos (stories) e vídeos fora do Instagram (screen).
import CarouselPost from "./CarouselPost.astro";
import StoryPost from "./StoryPost.astro";
import SocialProfile from "./SocialProfile.astro";
import Icon from "../Icon.astro";
import type { Case, AssetItem } from "../../data/cases";

interface Props { c: Case }
const { c } = Astro.props;
const s = c.social!;
const byId = (id: string) => c.items.find((it) => it.id === id)!;
const slides = (key: string) => c.items.filter((it) => it.group === key);
const logo = byId(s.avatar ?? "logo");
const elements = c.items.filter((it) => it.group === "elementos");
// linguagem com ladrilhos em SVG (CAU/PE) ou com recortes de posts
const pattern = c.items.find((it) => it.id === "padrao");
// uma faixa de ladrilhos para cada frente: as duas tiras de 4 ladrilhos e uma fileira do painel 5×5
// (cols = ladrilhos por fileira; a imagem é cortada nessa proporção)
const tiles: { src: string; cols: number }[] = pattern
  ? [
      { src: byId("padrao-2").src, cols: 4 },
      { src: byId("padrao-3").src, cols: 4 },
      { src: pattern.src, cols: 5 },
    ]
  : [];
const pad = (n: number) => String(n).padStart(2, "0");
const words = ["zero", "uma", "duas", "três", "quatro", "cinco", "seis", "sete", "oito", "nove", "dez", "onze", "doze"];
const inWords = (n: number) => words[n] ?? String(n);
const order = s.fronts.flatMap((f) => s.carousels.filter((k) => k.front === f.key));
const numberOf = (key: string) => pad(order.findIndex((k) => k.key === key) + 1);
const count = (items: AssetItem[]) => {
  const v = items.filter((it) => it.video).length;
  return `${items.length} telas${v ? ` · ${v} em vídeo` : ""}`;
};
const gcd = (a: number, b: number): number => (b ? gcd(b, a % b) : a);
const ratioOf = (it: AssetItem) => `${it.w / gcd(it.w, it.h)}:${it.h / gcd(it.w, it.h)}`;
// com stories: "6 telas + 6 stories" (ou "post + 4 stories")
const countAll = (key: string) => {
  const feed = slides(key), st = slides(`${key}-st`);
  if (!st.length) return count(feed);
  return `${feed.length === 1 ? "post" : `${feed.length} telas`} + ${st.length} stories`;
};
// recorte 4:3 de um post: a arte inteira é ampliada e deslocada dentro da moldura
const crop = (d: NonNullable<typeof s.system.details>[number]) => {
  const it = byId(d.id);
  const imgH = 1 / d.w / (it.w / it.h); // altura da arte em larguras de moldura
  return `width:${(100 / d.w).toFixed(3)}%;left:${((-d.x / d.w) * 100).toFixed(3)}%;top:${((-d.y * imgH) / 0.75 * 100).toFixed(3)}%`;
};
const looseStories = slides("stories");
const screens = slides("tela");
---
{s.intro && (
  <header class="ss-intro container">
    <p class="eyebrow" data-reveal>Redes sociais</p>
    <h2 class="title-section" data-split set:html={s.intro.title} />
    <p class="lead" data-reveal>{s.intro.note}</p>
  </header>
)}

<section class="ss-stats container" aria-label="O projeto em números">
  <ul>
    {s.stats.map((st) => (
      <li data-reveal><b class="display">{st.n}</b><span>{st.label}</span></li>
    ))}
  </ul>
</section>

{s.page && <SocialProfile c={c} />}

<section class="ss-system">
  <div class="container">
    <header class="ss-system-head">
      <p class="eyebrow" data-reveal>Linguagem dos posts</p>
      <h2 class="title-section" data-split set:html={s.system.title} />
      <p class="lead" data-reveal>{s.system.note}</p>
    </header>
    {pattern && (
      <div class="ss-system-grid">
        <figure class="ss-mosaic" data-reveal>
          <img src={pattern.src} width="1080" height="1080" alt="Painel de ladrilhos usado nas capas" loading="lazy" />
        </figure>
        <ul class="ss-elements">
          {elements.map((el, k) => (
            <li data-reveal>
              <span class="ss-el-art"><img src={el.src} width={el.w} height={el.h} alt="" loading="lazy" /></span>
              <span class="ss-el-label">{s.system.elements?.[k]}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
    <ul class:list={["ss-palette", { "ss-palette--short": !pattern }]} style={`--n:${s.system.palette.length}`} aria-label="Paleta">
      {s.system.palette.map((p) => (
        <li data-reveal>
          <span class="ss-swatch" style={`background:${p.hex}`}></span>
          <span class="ss-color"><b>{p.name}</b><span>{p.hex}</span></span>
        </li>
      ))}
    </ul>
    {s.system.details && (
      <ol class="ss-details">
        {s.system.details.map((d) => {
          const it = byId(d.id);
          return (
            <li data-reveal>
              <button type="button" class="ss-detail" data-lightbox={it.src} data-lb-group="detalhes" data-w={it.w} data-h={it.h} aria-label={`Ampliar o post inteiro: ${d.title}`}>
                <span class="ss-crop"><img src={it.src} width={it.w} height={it.h} alt="" style={crop(d)} loading="lazy" decoding="async" /></span>
                <span class="ss-detail-t">{d.title}</span>
                <span class="ss-detail-n">{d.note}</span>
              </button>
            </li>
          );
        })}
      </ol>
    )}
  </div>
</section>

<nav class="ss-index container" aria-label="Carrosséis do projeto">
  <div class="ss-index-head">
    <p class="eyebrow" data-reveal>Carrosséis</p>
    <h2 class="title-section" data-split>{`${inWords(s.fronts.length)[0].toUpperCase()}${inWords(s.fronts.length).slice(1)} frentes, `}<em>{inWords(s.carousels.length)}</em> sequências</h2>
  </div>
  <div class:list={["ss-index-cols", { "ss-index-cols--4": s.fronts.length === 4 }]}>
    {s.fronts.map((f, fi) => (
      <div class="ss-index-col" data-reveal>
        <p class="ss-index-front"><span>{pad(fi + 1)}</span>{f.label}</p>
        <ol>
          {s.carousels.filter((k) => k.front === f.key).map((k) => {
            const items = slides(k.key);
            return (
              <li>
                <a href={`#c-${k.key}`} class="ss-index-link">
                  <img src={items[0].src} width={items[0].w} height={items[0].h} alt="" loading="lazy" />
                  <span class="ss-index-n">{numberOf(k.key)}</span>
                  <span class="ss-index-t">{k.title}</span>
                  <span class="ss-index-m">{countAll(k.key)}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    ))}
  </div>
</nav>

{s.fronts.map((f, fi) => (
  <section class="ss-front" id={`frente-${f.key}`} aria-labelledby={`frente-${f.key}-t`}>
    <header class="ss-front-head container">
      <div class="ss-front-text">
        <p class="eyebrow" data-reveal>{`Frente ${pad(fi + 1)}`}</p>
        <h2 class="ss-front-title display" id={`frente-${f.key}-t`} data-reveal>{f.label}</h2>
        <p class="lead" data-reveal>{f.note}</p>
      </div>
      {tiles.length > 0 && <img class="ss-front-tiles" src={tiles[fi % tiles.length].src} style={`--cols:${tiles[fi % tiles.length].cols}`} alt="" loading="lazy" data-reveal />}
    </header>

    {s.carousels.filter((k) => k.front === f.key).map((k) => {
      const items = slides(k.key);
      const stories = slides(`${k.key}-st`);
      const duo = stories.length > 0;
      const flip = Number(numberOf(k.key)) % 2 === 0;
      return duo ? (
        <article class:list={["cb cb--duo container", { "cb--flip": flip }]} id={`c-${k.key}`}>
          <div class="cb-head">
            <p class="eyebrow" data-reveal>{`${numberOf(k.key)} — ${f.label}`}</p>
            <h3 class="cb-title" data-reveal>{k.title}</h3>
            <p class="cb-note" data-reveal>{k.note}</p>
            <ul class="cb-meta" data-reveal>
              <li>{k.when}</li>
              <li>{`${items.length === 1 ? "Post único" : `${items.length} telas`} · ${ratioOf(items[0])}`}</li>
              <li>{`${stories.length} ${stories.length === 1 ? "story" : "stories"} · ${ratioOf(stories[0])}`}</li>
            </ul>
          </div>
          <div class="cb-roots">
            <div class="cb-root" data-carousel>
              <div class="cb-post" data-reveal>
                <CarouselPost group={k.key} title={k.title} profile={s.profile} place={s.place} avatar={logo.src} items={items} />
              </div>
              {items.length > 1 && (
                <div class="cb-strip" data-reveal>
                  <p class="cb-strip-label">Feed <span>— as telas lado a lado, como a pessoa desliza</span></p>
                  <ol class="strip">
                    {items.map((it, i) => (
                      <li>
                        <button type="button" class:list={["strip-btn", { "is-active": i === 0 }]} data-car-go={i} aria-label={`Ver tela ${i + 1}`}>
                          <img src={it.src} width={it.w} height={it.h} alt="" loading="lazy" decoding="async" />
                        </button>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </div>
            <div class="cb-root" data-carousel>
              <div class="cb-story" data-reveal>
                <StoryPost group={`${k.key}-st`} title={k.title} profile={s.profile} avatar={logo.src} items={stories} />
              </div>
              {stories.length > 1 && (
                <div class="cb-strip cb-strip--st" data-reveal>
                  <p class="cb-strip-label">Stories <span>— na ordem em que aparecem</span></p>
                  <ol class="strip strip--st">
                    {stories.map((it, i) => (
                      <li>
                        <button type="button" class:list={["strip-btn", { "is-active": i === 0 }]} data-car-go={i} aria-label={`Ver story ${i + 1}`}>
                          <img src={it.src} width={it.w} height={it.h} alt="" loading="lazy" decoding="async" />
                        </button>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </div>
          </div>
        </article>
      ) : (
        <article class:list={["cb container", { "cb--flip": flip }]} id={`c-${k.key}`} data-carousel>
          <div class="cb-head">
            <p class="eyebrow" data-reveal>{`${numberOf(k.key)} — ${f.label}`}</p>
            <h3 class="cb-title" data-reveal>{k.title}</h3>
            <p class="cb-note" data-reveal>{k.note}</p>
            <ul class="cb-meta" data-reveal>
              <li>{k.when}</li>
              <li>{count(items)}</li>
              <li>{`${ratioOf(items[0])} · ${items[0].w} × ${items[0].h} px`}</li>
            </ul>
          </div>
          <div class="cb-post" data-reveal>
            <CarouselPost group={k.key} title={k.title} profile={s.profile} place={s.place} avatar={logo.src} items={items} />
          </div>
          <div class="cb-strip" data-reveal>
            <p class="cb-strip-label">Sequência completa <span>— as telas lado a lado, como a pessoa desliza</span></p>
            <ol class="strip">
              {items.map((it, i) => (
                <li>
                  <button type="button" class:list={["strip-btn", { "is-active": i === 0 }]} data-car-go={i} aria-label={`Ver tela ${i + 1}`}>
                    <img src={it.src} width={it.w} height={it.h} alt="" loading="lazy" decoding="async" />
                    {it.video && <span class="strip-play"><Icon name="play" size={12} /></span>}
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </article>
      );
    })}
  </section>
))}

{s.singles && (
  <section class="ss-singles container" aria-labelledby="ss-singles-t">
    <header class="ss-singles-head">
      <p class="eyebrow" data-reveal>Posts avulsos</p>
      <h2 class="title-section" id="ss-singles-t" data-split set:html={s.singles.title} />
      <p class="lead" data-reveal>{s.singles.note}</p>
    </header>
    <ol class="ss-singles-grid">
      {s.singles.list.map((p, k) => {
        const it = slides(p.key)[0];
        return (
          <li data-reveal>
            <button type="button" class="ss-single" data-lightbox={it.src} data-lb-group="avulsos" data-w={it.w} data-h={it.h} data-cursor="view" aria-label={`Ampliar o post ${p.title}`}>
              <span class="ss-single-art"><img src={it.src} width={it.w} height={it.h} alt={`${p.title} — post de ${c.title}`} loading="lazy" decoding="async" /></span>
              <span class="ss-single-cap"><b>{pad(k + 1)}</b><span class="ss-single-t">{p.title}</span><small>{p.when}</small></span>
            </button>
          </li>
        );
      })}
    </ol>
  </section>
)}

{s.stories && looseStories.length > 0 && (
  <section class="ss-stories" aria-labelledby="ss-stories-t" data-tray>
    <div class="container ss-stories-head">
      <div class="ss-stories-text">
        <p class="eyebrow" data-reveal>Stories avulsos</p>
        <h2 class="title-section" id="ss-stories-t" data-split set:html={s.stories.title} />
        <p class="lead" data-reveal>{s.stories.note}</p>
      </div>
      <div class="ss-tray-nav" data-reveal>
        <span class="ss-tray-meta">{`${looseStories.length} stories · 9:16`}</span>
        <button type="button" class="ss-tray-btn-nav" data-tray-prev aria-label="Stories anteriores"><Icon name="chevron-left" size={20} /></button>
        <button type="button" class="ss-tray-btn-nav" data-tray-next aria-label="Próximos stories"><Icon name="chevron-right" size={20} /></button>
      </div>
    </div>
    <ol class="ss-tray" data-tray-track data-lenis-prevent-horizontal>
      {looseStories.map((it, k) => (
        <li>
          <button type="button" class="ss-tray-item" data-lightbox={it.src} data-lb-group="stories" data-w={it.w} data-h={it.h} aria-label={`Ampliar o story ${it.label}`}>
            <img src={it.src} width={it.w} height={it.h} alt={`${it.label} — story de ${c.title}`} loading="lazy" decoding="async" />
          </button>
          <span class="ss-tray-cap"><b>{pad(k + 1)}</b>{it.label}</span>
        </li>
      ))}
    </ol>
  </section>
)}

{s.screen && screens.length > 0 && (
  <section class="ss-screen" aria-labelledby="ss-screen-t">
    <div class="container ss-screen-grid">
      <header class="ss-screen-head">
        <p class="eyebrow" data-reveal>{s.screen.eyebrow}</p>
        <h2 class="title-section" id="ss-screen-t" data-split set:html={s.screen.title} />
        <p class="lead" data-reveal>{s.screen.note}</p>
      </header>
      <ul class="ss-tvs">
        {screens.map((it) => (
          <li data-reveal>
            <figure class="ss-tv">
              <button type="button" class="ss-tv-screen" data-lightbox={it.video} data-poster={it.src} data-lb-group="tela" data-w={it.w} data-h={it.h} aria-label={`Ampliar o vídeo ${it.label}`}>
                <video width={it.w} height={it.h} poster={it.src} muted loop playsinline preload="none" data-autoplay>
                  <source src={it.video} type="video/mp4" />
                </video>
              </button>
              <figcaption><b>{it.label}</b><span>{s.screen!.spec}</span></figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  /* abertura (quando o case começa pelo site) */
  .ss-intro { display: grid; gap: 20px; padding-block: clamp(24px, 4vw, 56px) clamp(40px, 5vw, 72px); }
  .ss-intro > * { max-width: 820px; }

  /* números */
  .ss-stats { padding-bottom: clamp(56px, 7vw, 104px); }
  .ss-stats ul { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--border); }
  @media (min-width: 800px) { .ss-stats ul { grid-template-columns: repeat(4, 1fr); } }
  .ss-stats li { display: grid; gap: 6px; padding: 24px 20px 0 0; }
  .ss-stats b { font-size: clamp(3.5rem, 8vw, 6.5rem); color: var(--accent); }
  .ss-stats span { color: var(--text-muted); font-size: 0.9375rem; }

  /* linguagem dos posts */
  .ss-system { background: var(--bg-elev); border-block: 1px solid var(--border); padding-block: clamp(64px, 8vw, 120px); }
  .ss-system-head { display: grid; gap: 20px; max-width: 760px; margin-bottom: clamp(36px, 5vw, 64px); }
  .ss-system-grid { display: grid; gap: clamp(12px, 1.6vw, 20px); }
  @media (min-width: 900px) { .ss-system-grid { grid-template-columns: 1fr 1.3fr; } }
  .ss-mosaic { aspect-ratio: 1; border-radius: var(--radius-card); overflow: hidden; }
  .ss-mosaic img { width: 100%; height: 100%; object-fit: cover; }
  .ss-elements { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(12px, 1.6vw, 20px); }
  @media (min-width: 600px) { .ss-elements { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 1fr); } }
  .ss-elements li {
    display: grid; grid-template-rows: 1fr auto; gap: 14px; min-height: 180px;
    padding: 18px; border-radius: var(--radius-card);
    background: var(--bg); border: 1px solid var(--border);
    transition: border-color 0.3s;
  }
  .ss-elements li:hover { border-color: var(--border-strong); }
  .ss-el-art { position: relative; display: grid; place-items: center; min-height: 0; }
  .ss-el-art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: scale 0.6s var(--ease); }
  .ss-elements li:hover .ss-el-art img { scale: 1.06; }
  .ss-el-label { font-size: 0.875rem; color: var(--text-muted); }
  .ss-palette { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(12px, 1.6vw, 20px); margin-top: clamp(28px, 4vw, 48px); }
  @media (min-width: 900px) { .ss-palette { grid-template-columns: repeat(7, 1fr); } }
  /* paleta curta, sem o painel de ladrilhos: abre a seção e ocupa a largura toda */
  .ss-palette--short { margin-top: 0; grid-template-columns: repeat(3, 1fr); }
  @media (min-width: 900px) { .ss-palette--short { grid-template-columns: repeat(var(--n), 1fr); } }
  .ss-palette li { display: grid; gap: 10px; }
  .ss-swatch { height: clamp(64px, 8vw, 120px); border-radius: 16px; box-shadow: inset 0 0 0 1px var(--border); }
  .ss-color { display: grid; font-size: 0.8125rem; line-height: 1.4; }
  .ss-color b { font-weight: 600; }
  .ss-color span { color: var(--text-muted); font-variant-numeric: tabular-nums; }

  /* recortes de posts */
  .ss-details { display: grid; gap: clamp(12px, 1.6vw, 20px); margin-top: clamp(28px, 4vw, 48px); }
  @media (min-width: 600px) { .ss-details { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .ss-details { grid-template-columns: repeat(3, 1fr); } }
  .ss-detail {
    display: grid; gap: 6px; width: 100%; height: 100%; align-content: start; text-align: left;
    padding: 10px 10px 18px; border-radius: 20px; background: var(--bg); border: 1px solid var(--border);
    cursor: zoom-in; transition: border-color 0.25s;
  }
  .ss-detail:hover { border-color: var(--accent); }
  .ss-crop { position: relative; display: block; aspect-ratio: 4 / 3; margin-bottom: 10px; border-radius: 12px; overflow: hidden; background: #000; }
  .ss-crop img { position: absolute; max-width: none; height: auto; transition: scale 0.8s var(--ease); transform-origin: 50% 30%; }
  .ss-detail:hover .ss-crop img { scale: 1.04; }
  .ss-detail-t { padding-inline: 6px; font-weight: 600; letter-spacing: -0.01em; }
  .ss-detail-n { padding-inline: 6px; font-size: 0.875rem; line-height: 1.5; color: var(--text-muted); }

  /* índice */
  .ss-index { display: grid; gap: clamp(28px, 4vw, 48px); padding-block: clamp(72px, 9vw, 136px) clamp(24px, 4vw, 48px); }
  .ss-index-head { display: grid; gap: 16px; }
  .ss-index-cols { display: grid; gap: 28px; }
  @media (min-width: 900px) { .ss-index-cols { grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 28px); } }
  @media (min-width: 700px) { .ss-index-cols--4 { grid-template-columns: repeat(2, 1fr); gap: 28px clamp(16px, 2vw, 28px); } }
  @media (min-width: 1200px) { .ss-index-cols--4 { grid-template-columns: repeat(4, 1fr); } }
  .ss-index-front { display: flex; align-items: baseline; gap: 10px; padding-bottom: 14px; margin-bottom: 6px; border-bottom: 1px solid var(--border); font-family: var(--font-heading); font-weight: 600; font-size: 1.125rem; }
  .ss-index-front span { font-family: var(--font-display); color: var(--accent); }
  .ss-index-link {
    display: grid; grid-template-columns: 48px 2rem 1fr; grid-template-rows: auto auto; column-gap: 12px; align-items: center;
    padding: 12px 8px 12px 0; border-bottom: 1px solid var(--border);
    transition: background-color 0.25s, padding 0.35s var(--ease);
  }
  .ss-index-link img { grid-row: span 2; width: 48px; height: 60px; object-fit: cover; border-radius: 8px; }
  .ss-index-n { grid-row: span 2; font-family: var(--font-display); font-size: 1.25rem; color: var(--text-muted); transition: color 0.25s; }
  .ss-index-t { font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
  .ss-index-m { font-size: 0.8125rem; color: var(--text-muted); }
  .ss-index-link:hover { padding-left: 8px; background: var(--surface-glass); }
  .ss-index-link:hover .ss-index-n { color: var(--accent); }

  /* frentes */
  .ss-front { padding-top: clamp(56px, 7vw, 96px); }
  .ss-front-head { display: grid; gap: 28px; align-items: end; padding-bottom: clamp(8px, 2vw, 24px); }
  @media (min-width: 900px) { .ss-front-head { grid-template-columns: 1fr auto; } }
