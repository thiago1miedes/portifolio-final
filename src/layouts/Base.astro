---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource/pixelify-sans/500.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  page?: string;
}
const { title, description = site.description, image = "/og.png", page = "default" } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} · Web design & front-end`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="pt-BR" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Liga os estados iniciais das animações só quando há JS e movimento permitido.
      (function () {
        var d = document.documentElement;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        d.classList.add("js");
        try { if (sessionStorage.getItem("px-nav") === "1") d.classList.add("is-arriving"); } catch (e) {}
        window.__failsafe = setTimeout(function () { d.classList.remove("js", "is-arriving"); }, 4000);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <div class="cursor" aria-hidden="true"><span class="cursor-dot"></span><span class="cursor-label">Ver case</span></div>
    <div class="px-wipe" aria-hidden="true"></div>

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed; left: 16px; top: -60px; z-index: 200;
    background: var(--ink); color: #fff; padding: 10px 16px; border-radius: 8px;
    transition: top 0.2s;
  }
  .skip:focus { top: 16px; }

  /* cursor personalizado (só em mouse) */
  .cursor {
    position: fixed; left: 0; top: 0; z-index: 150;
    pointer-events: none;
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .js .cursor { display: block; }
  }
  .cursor-dot {
    position: absolute; left: -6px; top: -6px;
    width: 12px; height: 12px;
    background: var(--leaf);
    box-shadow: 4px 4px 0 var(--marine);
    transition: transform 0.35s var(--ease), opacity 0.3s;
  }
  .cursor-label {
    position: absolute; left: 0; top: 0;
    transform: translate(-50%, -50%) scale(0);
    display: grid; place-items: center;
    width: 96px; height: 96px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-pixel);
    font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase;
    transition: transform 0.45s var(--ease);
  }
  .cursor.is-view .cursor-label { transform: translate(-50%, -50%) scale(1); }
  .cursor.is-view .cursor-dot { opacity: 0; }
  .cursor.is-link .cursor-dot { transform: scale(2.2) rotate(45deg); }

  /* transição entre páginas: grade de pixels */
  .px-wipe {
    position: fixed; inset: 0; z-index: 180;
    display: grid;
    pointer-events: none;
  }
  .px-wipe i { background: var(--marine); transform: scale(0); }
  .px-wipe i:nth-child(3n) { background: var(--forest); }
  .px-wipe i:nth-child(7n) { background: var(--marine-2); }
  .is-arriving .px-wipe:empty { background: var(--marine); }
  .is-arriving .px-wipe i { transform: scale(1.02); }
</style>
