---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Página não encontrada" page="404">
  <section class="nf">
    <div class="container nf-inner">
      <p class="eyebrow" data-hero-fade>Erro 404</p>
      <h1 class="nf-title display" data-page-title><span>Página</span> <em>perdida</em></h1>
      <p class="lead" data-hero-fade>A página que você procura não existe ou mudou de lugar.</p>
      <div class="nf-actions" data-hero-fade>
        <a href="/" class="btn btn--accent">Voltar ao início <Icon name="arrow-up-right" class="icon--arrow" /></a>
        <a href="/cases/" class="btn btn--ghost">Ver projetos</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 90svh; display: grid; align-items: center; padding: 160px 0 80px; }
  .nf-inner { display: grid; gap: 24px; justify-items: start; }
  .nf-title { font-size: clamp(4rem, 15vw, 13rem); display: grid; }
  .nf-title em { font-style: normal; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
