---
import Base from "../layouts/Base.astro";
import PixelWorld from "../components/PixelWorld.astro";
---
<Base title="Página não encontrada" page="404">
  <section class="nf">
    <div class="container nf-inner">
      <span class="eyebrow" data-hero-fade>Erro 404</span>
      <h1 class="h-display" data-hero-title>Esse bloco ainda não foi <span class="mark">construído</span>.</h1>
      <p class="lead" data-hero-fade>A página que você procura não existe ou mudou de lugar.</p>
      <div data-hero-fade style="display:flex;gap:12px;flex-wrap:wrap">
        <a href="/" class="btn btn--green">Voltar ao início</a>
        <a href="/cases/" class="btn btn--ghost">Ver projetos</a>
      </div>
    </div>
    <PixelWorld seed={404} />
  </section>
</Base>
<style>
  .nf { position: relative; min-height: 100svh; padding: 170px 0 300px; overflow: hidden; }
  .nf-inner { position: relative; z-index: 2; display: grid; gap: 24px; justify-items: start; }
  .nf :global(.pixel-world) { height: 280px; }
</style>
