---
import Base from "../../layouts/Base.astro";
import BrowserFrame from "../../components/BrowserFrame.astro";
import PhoneFrame from "../../components/PhoneFrame.astro";
import Icon from "../../components/Icon.astro";
import BrandCase from "../../components/brand/BrandCase.astro";
import { cases, categories, type AssetItem } from "../../data/cases";
import { brandCases } from "../../data/brand-cases";

export function getStaticPaths() {
  return cases.map((c, i) => ({ params: { slug: c.slug }, props: { i } }));
}
const { i } = Astro.props;
const c = cases[i];
const next = cases[(i + 1) % cases.length];
// com cases/<slug>/case.json, a página vira o case narrativo de marca
const brand = brandCases[c.slug];

const pages = c.items.filter((it) => it.kind === "page");
const mobiles = c.items.filter((it) => it.kind === "mobile");
const rest = c.items.filter((it) => it.kind !== "page" && it.kind !== "mobile");
const cover = pages[0];
const visualCover = !cover ? (rest.find((it) => it.id === c.cover) ?? rest[0]) : undefined;

const host = (u?: string) => (u ? new URL(u).host.replace(/^www\./, "") : "");
const fakeUrl = (label?: string) => `${host(c.live) || c.slug + ".com.br"}${label && !/home|site no ar|landing|one page/i.test(label) ? "/" + label.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") : ""}`;

// agrupa a galeria por tipo de peça, preservando a ordem
const labels: Record<string, string> = {
  slide: "Apresentação", image: "Aplicações", post: "Peças", social: "Social media", stories: "Stories",
  print: "Impressos", banners: "Banners de site", brand: "Marca", packaging: "Embalagens",
};
const layoutOf = (k: string) =>
  k === "slide" ? "slides" : k === "banners" ? "banners" : k === "post" || k === "social" || k === "stories" ? "posts" : "images";
// peças de rede social e banners: cada formato vira uma seção própria, com medida e uso
const formats: Record<string, { label: string; title: string; note: string; ratio: string; layout: string; split?: boolean; chrome?: boolean }> = {
  stories: { label: "Stories", title: "Campanhas em 9:16", ratio: "9:16", layout: "stories", note: "Uma peça por campanha: Black Decants, aniversário, Semana do Consumidor e desconto progressivo de verão." },
  serie: { label: "Série de stories", title: "Vantagens de ter um decant", ratio: "9:16", layout: "track", note: "Nove stories em sequência para apresentar o decant: vantagens, antes e depois e o cupom de boas-vindas." },
  feed: { label: "Feed", title: "Post em 4:5", ratio: "4:5", layout: "feed", split: true, note: "O formato vertical do feed ocupa mais tela que o quadrado. Aqui, o lançamento da Black Decants." },
  banners: { label: "Banners de site", title: "Home em desktop", ratio: "1580 × 450", layout: "banners", chrome: true, note: "Os banners principais da home da loja, um por campanha." },
  "banners-mobile": { label: "Banners mobile", title: "Home em celular", ratio: "41:50", layout: "mobile", note: "A versão vertical de cada banner, recomposta para a tela pequena em vez de apenas reduzida." },
  "banners-categoria": { label: "Banners de categoria", title: "Faixa larga das categorias", ratio: "2580 × 450", layout: "banners", chrome: true, note: "A faixa que abre as páginas de categoria, mais baixa e mais larga que o banner da home." },
};
const groups: { key: string; items: AssetItem[] }[] = [];
for (const it of rest.filter((x) => x !== visualCover && x.group !== "capa")) {
  const key = it.group ?? it.kind;
  let g = groups.find((x) => x.key === key);
  if (!g) groups.push((g = { key, items: [] }));
  g.items.push(it);
}
const logoCover = visualCover?.group === "capa";
const hasFormats = groups.some((g) => formats[g.key]);
const specOf = (g: { items: AssetItem[] }) => `${g.items[0].w} × ${g.items[0].h} px`;
const meta = [
  { k: "Cliente", v: c.client },
  { k: "Segmento", v: c.sector },
  ...(c.year ? [{ k: "Ano", v: c.year }] : []),
  { k: "Ferramentas", v: c.tools.join(", ") },
];
---
{brand ? <BrandCase data={brand} next={next} /> : (
<Base title={c.title} description={c.summary} image={c.thumb.src} page="case">
  <article class="case" data-project={c.slug}>
    <header class="case-hero container">
      <a href="/cases/" class="case-back"><Icon name="arrow-left" size={18} /> Todos os projetos</a>
      <div class="case-cats" data-hero-fade>
        {c.cats.map((k) => <span class="chip">{categories[k]}</span>)}
        {c.live && <span class="chip chip--live"><i></i>Site no ar</span>}
      </div>
      <h1 class="case-title display" data-page-title>{c.title}</h1>
      <div class="case-intro">
        <p class="lead" data-hero-fade>{c.summary}</p>
        <div class="case-actions" data-hero-fade>
          {c.live && (
            <a href={c.live} target="_blank" rel="noopener" class="btn btn--accent">
              Visitar site <Icon name="arrow-up-right" class="icon--arrow" />
            </a>
          )}
          <a href="#galeria" class="btn btn--ghost">Ver projeto</a>
        </div>
      </div>
      <dl class="case-meta" data-hero-fade>
        {meta.map((m) => <div><dt>{m.k}</dt><dd>{m.v}</dd></div>)}
      </dl>
    </header>

    {cover && (
      <section class="case-cover" data-cover-scrub>
        <div class="cover-sticky container">
          <BrowserFrame src={cover.src} w={cover.w} h={cover.h} alt={`Página ${cover.label ?? "inicial"} do site ${c.title}`} url={fakeUrl(cover.label)} mode="scrub" ratio="16 / 9" class="cover-browser" eager />
          <p class="cover-hint"><i aria-hidden="true"></i>Role a página para navegar pelo layout</p>
        </div>
      </section>
    )}
    {visualCover && (
      <section class="case-cover-img container">
        <div class:list={["cover-img", { "cover-img--logo": logoCover }]} data-parallax-wrap={logoCover ? undefined : ""}>
          <img src={visualCover.src} width={visualCover.w} height={visualCover.h} alt={logoCover ? `Logo ${c.title}` : `Projeto ${c.title}`} data-parallax-img={logoCover ? undefined : ""} loading="eager" />
        </div>
      </section>
    )}

    <section class="case-about container">
      <div class="ca-text">
        <p class="eyebrow" data-reveal>Sobre o projeto</p>
        {c.about.map((p, k) => <p class:list={[{ lead: k === 0 }]} data-reveal>{p}</p>)}
        {c.credit && <p class="ca-credit" data-reveal>{c.credit}.</p>}
      </div>
      <aside class="ca-side" data-reveal>
        <h2>Entregas</h2>
        <ul>{c.deliverables.map((d) => <li>{d}</li>)}</ul>
      </aside>
    </section>

    <div id="galeria"></div>

    {pages.length > 0 && (
      <section class="case-pages container" data-tabs>
        <div class="cp-head">
          <p class="eyebrow" data-reveal>{pages.length > 1 ? "Páginas do site" : "Layout completo"}</p>
          <h2 class="h-card" data-reveal>{pages.length > 1 ? `${pages.length} telas desenhadas` : "Navegue pela página inteira"}</h2>
        </div>
        <div class:list={["cp-tabs", { "is-hidden": pages.length < 2 }]} role="tablist" aria-label="Páginas do site">
          {pages.map((p, k) => (
            <button type="button" role="tab" class:list={["cp-tab", { "is-active": k === 0 }]} aria-selected={k === 0 ? "true" : "false"} aria-controls={`tab-${p.id}`} id={`t-${p.id}`} data-tab={k}>{p.label ?? `Página ${k + 1}`}</button>
          ))}
        </div>
        <div class="cp-panels">
          {pages.map((p, k) => (
            <div class:list={["cp-panel", { "is-hidden": k !== 0 }]} role="tabpanel" id={`tab-${p.id}`} aria-labelledby={`t-${p.id}`} data-panel={k}>
              <BrowserFrame src={p.src} w={p.w} h={p.h} alt={`Página ${p.label} do site ${c.title}`} url={fakeUrl(p.label)} mode="scroll" ratio="16 / 10" />
            </div>
          ))}
        </div>
        <p class="cp-hint">Passe o mouse sobre a janela e role para navegar pela página.</p>
      </section>
    )}

    {mobiles.length > 0 && (
      <section class="case-mobile">
        <div class="container cm-grid">
          <div class="cm-text">
            <p class="eyebrow" data-reveal>Versão mobile</p>
            <h2 class="title-section" data-split>Pensado para o <em>polegar</em>.</h2>
            <p class="lead" data-reveal>Hierarquia, botões e menus adaptados para o celular — onde acontece a maior parte das visitas.</p>
          </div>
          <div class="cm-phones">
            {mobiles.slice(0, 2).map((m, k) => (
              <div class="cm-phone" data-reveal data-float={k}>
                <PhoneFrame src={m.src} w={m.w} h={m.h} alt={`Site ${c.title} no celular`} mode="scroll" />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {hasFormats && (
      <nav class="case-formats container" aria-label="Formatos do projeto">
        <p class="eyebrow" data-reveal>Formatos</p>
        <ol class="cf-list">
          {groups.map((g, k) => formats[g.key] && (
            <li data-reveal>
              <a href={`#f-${g.key}`} class="cf-link">
                <span class="cf-n">{String(k + 1).padStart(2, "0")}</span>
                <span class="cf-label">{formats[g.key].label}</span>
                <span class="cf-meta">{`${g.items.length} ${g.items.length === 1 ? "peça" : "peças"} · ${formats[g.key].ratio}`}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    {groups.map((g, gi) => {
      const f = formats[g.key];
      return (
      <section class:list={["case-gallery container", { "cg-sec--split": f?.split }]} id={f ? `f-${g.key}` : undefined}>
        <div class="cg-head">
          <div class="cg-title">
            <p class="eyebrow" data-reveal>{f ? `${String(gi + 1).padStart(2, "0")} — ${f.label}` : (labels[g.key] ?? "Galeria")}</p>
            {f && <h2 class="h-card" data-reveal>{f.title}</h2>}
            {f && <p class="cg-note" data-reveal>{f.note}</p>}
          </div>
          <span class="cg-count" data-reveal>
            {f && <b>{specOf(g)}</b>}
            {`${String(g.items.length).padStart(2, "0")} ${g.items.length === 1 ? "peça" : "peças"}`}
          </span>
        </div>
        <div class:list={["cg", `cg--${f?.layout ?? layoutOf(g.key)}`]}>
          {g.items.map((it) => (
            <button type="button" class:list={["cg-item", { "has-bar": f?.chrome }]} data-lightbox={it.src} data-w={it.w} data-h={it.h} data-reveal aria-label={`Ampliar ${it.label ?? "imagem"}`}>
              {f?.chrome && <span class="cg-bar" aria-hidden="true"><i></i><i></i><i></i></span>}
              <img src={it.src} width={it.w} height={it.h} alt={f ? `${f.label}: ${it.label} — ${c.title}` : `${labels[g.key] ?? "Imagem"} — ${c.title}`} loading="lazy" decoding="async" />
              {f && it.label && <span class="cg-cap">{it.label}</span>}
            </button>
          ))}
        </div>
      </section>
      );
    })}

    <nav class="case-next" aria-label="Próximo projeto">
      <a href={`/cases/${next.slug}/`} class="next-link container" data-cursor="view">
        <span class="eyebrow">Próximo projeto</span>
        <span class="next-row">
          <span class="next-title">{next.title}</span>
          <span class="next-thumb" aria-hidden="true"><img src={next.thumb.src} width={next.thumb.w} height={next.thumb.h} alt="" loading="lazy" /></span>
        </span>
        <span class="next-sector">{next.sector}</span>
      </a>
    </nav>
  </article>

  <dialog class="lightbox" data-lightbox-dialog aria-label="Imagem ampliada">
    <button type="button" class="lb-close" data-lb-close aria-label="Fechar">×</button>
    <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Anterior">←</button>
    <div class="lb-stage" data-lenis-prevent><img alt="" data-lb-img /></div>
    <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Próxima">→</button>
    <span class="lb-count" data-lb-count></span>
  </dialog>
</Base>
)}

<style>
  .case-hero { position: relative; padding-top: clamp(124px, 17vh, 168px); padding-bottom: clamp(32px, 4vw, 56px); display: grid; gap: 24px; }
  .case-back { justify-self: start; display: inline-flex; align-items: center; gap: 8px; font-weight: 500; color: var(--text-muted); font-size: 0.9375rem; transition: color 0.25s, gap 0.3s var(--ease); }
  .case-back:hover { color: var(--accent); gap: 12px; }
  .case-cats { display: flex; flex-wrap: wrap; gap: 6px; }
  .case-title { font-size: clamp(3.25rem, 10vw, 9rem); max-width: 12ch; }
  .case-intro { display: grid; gap: 24px; align-items: end; }
  @media (min-width: 1000px) { .case-intro { grid-template-columns: 1fr auto; gap: 48px; } }
  .case-intro .lead { max-width: 640px; }
  .case-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .case-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0; margin: 12px 0 0; border-top: 1px solid var(--border); }
  .case-meta div { padding: 18px 20px 0 0; display: grid; gap: 4px; }
  .case-meta dt { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .case-meta dd { margin: 0; font-size: 0.9375rem; color: var(--text); }
  .chip--live i { width: 6px; height: 6px; border-radius: 50%; background: #4ade80; }
  .chip--live { color: var(--text); }

  .case-cover { position: relative; }
  .cover-sticky { position: sticky; top: 92px; display: grid; gap: 14px; }
  .cover-sticky :global(.cover-browser .browser-view) { max-height: calc(100svh - 190px); }
  .cover-hint { display: inline-flex; align-items: center; gap: 10px; justify-self: center; font-size: 0.875rem; color: var(--text-muted); }
  .cover-hint i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: blink 1.6s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }

  .case-cover-img { padding-bottom: clamp(20px, 4vw, 40px); }
  .cover-img { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); background: var(--bg-elev); aspect-ratio: 16 / 9; }
  .cover-img img { width: 100%; height: 118%; object-fit: cover; }
  .cover-img--logo { aspect-ratio: 21 / 9; background: #000; position: relative; }
  .cover-img--logo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  @media (max-width: 700px) { .cover-img--logo { aspect-ratio: 4 / 3; } }

  .case-about { display: grid; gap: 36px; padding-block: clamp(56px, 7vw, 104px); }
  @media (min-width: 1000px) { .case-about { grid-template-columns: 1.4fr 0.6fr; gap: 80px; } }
  .ca-text { display: grid; gap: 20px; align-content: start; color: var(--text-muted); max-width: 760px; }
  .ca-text .lead { color: var(--text); font-size: clamp(1.25rem, 2vw, 1.625rem); line-height: 1.45; letter-spacing: -0.01em; }
  .ca-credit { font-size: 0.875rem; display: inline-flex; gap: 8px; align-items: center; }
  .ca-credit::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .ca-side { align-self: start; padding: 28px; border-radius: var(--radius-card); background: var(--surface-glass); border: 1px solid var(--border); }
  @media (min-width: 1000px) { .ca-side { position: sticky; top: 110px; } }
  .ca-side h2 { font-size: 1.25rem; letter-spacing: -0.02em; margin-bottom: 16px; }
  .ca-side ul { display: grid; gap: 10px; }
  .ca-side li { display: flex; gap: 12px; align-items: center; font-size: 0.9375rem; color: var(--text-muted); }
  .ca-side li::before { content: ""; width: 6px; height: 6px; flex: none; border-radius: 50%; background: var(--accent); }

  .case-pages { padding-bottom: clamp(48px, 6vw, 80px); display: grid; gap: 18px; }
  .cp-head { display: grid; gap: 12px; }
  .cp-tabs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-block: 4px; margin: 0 calc(var(--gutter) * -1); padding-inline: var(--gutter); }
  .cp-tabs::-webkit-scrollbar { display: none; }
  .cp-tab {
    flex: none; min-height: 40px; padding: 0 16px; border-radius: var(--radius-pill);
    background: var(--surface-glass); border: 1px solid var(--border);
    font-weight: 500; font-size: 0.875rem; color: var(--text-muted);
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
  }
  .cp-tab:hover { border-color: var(--border-strong); color: var(--text); }
  .cp-tab.is-active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .cp-panel :global(.browser-view) { max-height: 78vh; }
  .cp-hint { font-size: 0.875rem; color: var(--text-muted); text-align: center; }

  .case-mobile { background: var(--bg-elev); border-block: 1px solid var(--border); padding-block: clamp(64px, 8vw, 112px); margin-bottom: clamp(48px, 6vw, 80px); overflow: hidden; }
  .cm-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .cm-grid { grid-template-columns: 0.9fr 1.1fr; } }
  .cm-text { display: grid; gap: 20px; max-width: 480px; }
  .cm-phones { display: flex; justify-content: center; gap: clamp(16px, 4vw, 48px); }
  .cm-phone { width: min(300px, 46vw); }
  .cm-phone:nth-child(2) { margin-top: 56px; }

  .case-gallery { padding-bottom: clamp(40px, 5vw, 72px); }
  .cg-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18px; margin-bottom: 24px; border-bottom: 1px solid var(--border); }
  .cg-count { font-size: 0.8125rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .cg { display: grid; gap: clamp(12px, 1.6vw, 20px); }
  .cg-item { display: block; width: 100%; padding: 0; border: 1px solid var(--border); background: var(--bg-elev); border-radius: 18px; overflow: hidden; cursor: zoom-in; }
  .cg-item img { width: 100%; height: auto; transition: scale 0.8s var(--ease); }
  .cg-item:hover img { scale: 1.02; }
  .cg--slides { grid-template-columns: 1fr; }
  @media (min-width: 760px) {
    .cg--slides { grid-template-columns: 1fr 1fr; }
    .cg--slides .cg-item:nth-child(3n + 1) { grid-column: 1 / -1; }
    .cg--images { grid-template-columns: 1fr 1fr; align-items: start; }
    .cg--images .cg-item:first-child:nth-last-child(odd) { grid-column: 1 / -1; }
  }
  .cg--banners { grid-template-columns: 1fr; }
  .cg--posts { display: block; columns: 2; column-gap: clamp(12px, 1.6vw, 20px); }
  .cg--posts .cg-item { break-inside: avoid; margin-bottom: clamp(12px, 1.6vw, 20px); }
  @media (min-width: 760px) { .cg--posts { columns: 3; } }
  @media (min-width: 1100px) { .cg--posts { columns: 4; } }

  .case-formats { display: grid; gap: 18px; padding-bottom: clamp(40px, 5vw, 72px); }
  .cf-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  @media (min-width: 900px) { .cf-list { grid-template-columns: repeat(3, 1fr); } }
  .cf-link { display: grid; grid-template-columns: 2.25rem 1fr; column-gap: 14px; row-gap: 2px; align-items: baseline; height: 100%; padding: 16px 18px; border-radius: 16px; background: var(--surface-glass); border: 1px solid var(--border); transition: border-color 0.25s, background-color 0.25s; }
  .cf-link:hover { border-color: var(--accent); background: var(--bg-elev); }
  .cf-n { grid-row: span 2; font-family: var(--font-display); font-size: 1.5rem; color: var(--accent); line-height: 1; }
  .cf-label { font-weight: 600; letter-spacing: -0.01em; }
  .cf-meta { font-size: 0.8125rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }

  .cg-sec--split { display: grid; gap: 0 clamp(28px, 5vw, 80px); }
  @media (min-width: 900px) { .cg-sec--split { grid-template-columns: 1fr minmax(0, 440px); } .cg-sec--split .cg-head { border-bottom: 0; align-items: start; justify-content: flex-start; flex-direction: column; gap: 18px; } }
  .cg-title { display: grid; gap: 10px; max-width: 620px; }
  .cg-note { color: var(--text-muted); font-size: 0.9375rem; line-height: 1.55; }
  .cg-count { display: inline-flex; flex-direction: column; align-items: flex-end; gap: 2px; text-align: right; flex: none; }
  .cg-count b { font-weight: 500; color: var(--text); }
  .cg-sec--split .cg-count { align-items: flex-start; text-align: left; }
  .cg-head { gap: 24px; align-items: flex-end; }
  .cg-item.has-bar, .cg-item:has(.cg-cap) { display: flex; flex-direction: column; text-align: left; }
  .cg-bar { display: flex; gap: 6px; padding: 10px 14px; background: var(--surface-glass-2); border-bottom: 1px solid var(--border); }
  .cg-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--border-strong); }
  .cg-cap { padding: 10px 14px 12px; font-size: 0.8125rem; color: var(--text-muted); border-top: 1px solid var(--border); }
  .cg-item:hover .cg-cap { color: var(--text); }
  .cg--stories { grid-template-columns: repeat(2, 1fr); align-items: start; }
  @media (min-width: 760px) { .cg--stories { grid-template-columns: repeat(4, 1fr); } }
  .cg--track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 14px; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
  .cg--track .cg-item { flex: 0 0 clamp(190px, 24vw, 300px); width: auto; scroll-snap-align: start; align-self: flex-start; }
  .cg--feed { grid-template-columns: 1fr; align-items: start; }
  .cg--feed .cg-item { max-width: 440px; }
  .cg--mobile { grid-template-columns: repeat(2, 1fr); align-items: start; }
  @media (min-width: 760px) { .cg--mobile { grid-template-columns: repeat(3, 1fr); } }
