---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import FeaturedCases from "../components/FeaturedCases.astro";
import Services from "../components/Services.astro";
import ProjectsGrid from "../components/ProjectsGrid.astro";
import About from "../components/About.astro";
import Process from "../components/Process.astro";
import BehanceStrip from "../components/BehanceStrip.astro";
import Contact from "../components/Contact.astro";
import { clients } from "../data/site";
import { featured } from "../data/cases";
---
<Base page="home">
  <Hero />
  <Marquee items={clients} />
  <FeaturedCases />
  <Services />
  <section class="section" id="projetos">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow" data-reveal>Mais projetos</span>
          <h2 class="h-section" data-split style="margin-top:18px">Sites, marcas, campanhas <span class="hl">e muito mais</span>.</h2>
        </div>
        <p class="lead" data-reveal>Filtre por tipo de trabalho e explore. Cada projeto tem uma página com telas, aplicações e o que foi entregue.</p>
      </div>
      <ProjectsGrid limit={9} exclude={featured.map((c) => c.slug)} />
    </div>
  </section>
  <About />
  <Process />
  <BehanceStrip />
  <Contact />
</Base>
